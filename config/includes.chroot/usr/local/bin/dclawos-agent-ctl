#!/usr/bin/env python3
"""DclawOS agent control CLI (Phase 2 module 7): stop/resume/status/kill.

The human's intervention controls for the AI user (dclaw-agent):
  dclawos-agent-ctl stop [--reason TEXT]   # set the cooperative stop flag
  dclawos-agent-ctl resume                 # clear the flag
  dclawos-agent-ctl status                 # flag state as JSON
  dclawos-agent-ctl kill                   # sudo pkill -u dclaw-agent

Honesty note: the stop flag is COOPERATIVE — it takes effect when the
agent service checks it before each action (the service lands in a
later module; no service exists yet to honor it). The kill is
IMMEDIATE regardless: it terminates all agent processes now.
The monitor GUI (dclawos-monitor) is a thin frontend over this CLI
for the flag actions; it lists processes itself via ps.
"""

import argparse
import grp
import json
import os
import subprocess
import sys
import time

STOP_FLAG_DEFAULT = "/var/lib/dclawos/agent-stop.json"
AGENT_USER = "dclaw-agent"


def stop_flag_path():
    return os.environ.get("DCLAWOS_STOP_FLAG", STOP_FLAG_DEFAULT)


def _atomic_write(path, text):
    tmp = f"{path}.tmp.{os.getpid()}"
    with open(tmp, "w", encoding="utf-8") as handle:
        handle.write(text)
    try:
        os.chown(tmp, -1,
                 grp.getgrnam(os.environ.get(
                     "DCLAWOS_SHARED_GROUP", "dclawos-session")).gr_gid)
    except (KeyError, OSError):
        pass
    try:
        os.chmod(tmp, 0o644)
    except OSError:
        pass
    os.replace(tmp, path)


def cmd_stop(args):
    flag = {
        "stopped_by": "human-cli",
        "stopped_at": int(time.time()),
        "reason": args.reason or "human stop",
    }
    parent = os.path.dirname(stop_flag_path())
    if parent:
        os.makedirs(parent, exist_ok=True)
    _atomic_write(stop_flag_path(), json.dumps(flag, indent=2) + "\n")
    print(json.dumps({"agent": "stopped", "flag": flag}, indent=2))
    return 0


def cmd_resume(_args):
    try:
        os.unlink(stop_flag_path())
        print(json.dumps({"agent": "running", "resumed": True}, indent=2))
    except FileNotFoundError:
        print(json.dumps({"agent": "running",
                          "note": "no stop flag"}, indent=2))
    except OSError as exc:
        print(f"dclawos-agent-ctl: resume failed: {exc}", file=sys.stderr)
        return 1
    return 0


def cmd_status(_args):
    try:
        with open(stop_flag_path(), "r", encoding="utf-8") as handle:
            flag = json.load(handle)
        print(json.dumps({"agent": "stopped", "flag": flag}, indent=2))
    except FileNotFoundError:
        print(json.dumps({"agent": "running"}, indent=2))
    except (OSError, ValueError) as exc:
        print(f"dclawos-agent-ctl: status failed: {exc}", file=sys.stderr)
        return 1
    return 0


def cmd_kill(_args):
    try:
        proc = subprocess.run(
            ["sudo", "-n", "pkill", "-u", AGENT_USER],
            capture_output=True, text=True, timeout=15)
    except FileNotFoundError:
        print("dclawos-agent-ctl: sudo not available", file=sys.stderr)
        return 1
    except subprocess.TimeoutExpired:
        print("dclawos-agent-ctl: pkill timed out", file=sys.stderr)
        return 1
    if proc.returncode == 0:
        print(json.dumps({"killed": True}, indent=2))
        return 0
    if proc.returncode == 1:
        print(json.dumps({"killed": False,
                          "note": "no agent processes"}, indent=2))
        return 0
    print(f"dclawos-agent-ctl: pkill failed ({proc.returncode}): "
          f"{proc.stderr.strip()}", file=sys.stderr)
    return 1


def main():
    parser = argparse.ArgumentParser(prog="dclawos-agent-ctl")
    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("stop", help="set the cooperative stop flag")
    p.add_argument("--reason", default="")
    p.set_defaults(func=cmd_stop)

    p = sub.add_parser("resume", help="clear the stop flag")
    p.set_defaults(func=cmd_resume)

    p = sub.add_parser("status", help="show the stop flag state")
    p.set_defaults(func=cmd_status)

    p = sub.add_parser("kill", help="force-kill all agent processes")
    p.set_defaults(func=cmd_kill)

    args = parser.parse_args()
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
