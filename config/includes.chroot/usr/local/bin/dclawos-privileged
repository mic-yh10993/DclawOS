#!/usr/bin/env python3
"""DclawOS privileged broker (Phase 2 module 5): ticket-gated root ops.

Runs as root via systemd (dclawos-privileged.service). Listens on the
Unix socket /run/dclawos/privileged.sock (0660, shared exchange group
dclawos-session: root plus the AI user and the human, both members —
module 7). The AI never runs privileged commands
itself: it presents an APPROVED ticket (see ticketlib.py), and the
broker executes exactly the ticketed operation with exactly the
ticketed params — anything else is refused.

Whitelist (deliberately small; it grows module by module together
with the approval GUI):
- read-file: read a text file under /etc/dclawos/, /var/lib/dclawos/
  or /var/log/dclawos/ (symlinks resolved; 1 MB cap). Read-only.
- service-status: systemctl is-active for a DclawOS-owned unit
  (dclawos-* only). Read-only.
- restart-service: systemctl restart for a DclawOS-owned unit
  (dclawos-* only).
- package-install (Phase 3 M1): apt-get install of ONE package,
  name shape-validated; the agent user's privilege model allows
  installs, still ticketed here.
- write-secret (Phase 3 M1): write a named secret to
  /var/lib/dclawos/secrets/<name>, owner root, mode 0600; the
  agent reads only its own named files back at runtime.
Everything else (system config writes, arbitrary commands) is
refused. The broker logs ticket id + operation + outcome only —
never params contents and never ticket file contents.
(Header corrected in Phase 5 WS2: the module-5 text above claimed
package-install was refused — stale since Phase 3. Audit §2.)

Reuse notes (evaluation cards §5, step 0 retrieval):
- Ticket-gated execution follows the OpenClaw gateway approval PATTERN
  (approve-before-execute, per-operation ticket with expiry): the
  pattern is reused, the implementation is DclawOS-written (Unix socket
  + JSON ticket files instead of the gateway's HTTP approval flow).
// reuse-check: openclaw approval/HTTP flow NOT copied, reason: the
  gateway's approval is an HTTP service with its own auth model; the
  DclawOS broker is a local root daemon, so only the
  approve-before-execute pattern transfers, not the transport.
"""

import json
import os
import re
import socketserver
import stat
import subprocess
import sys
import time

sys.path.insert(0, "/usr/local/lib/dclawos")
sys.path.insert(0, os.path.join(
    os.path.dirname(os.path.abspath(__file__)), "..", "lib", "dclawos"))
import ticketlib  # noqa: E402

READ_PREFIXES = ("/etc/dclawos", "/var/lib/dclawos", "/var/log/dclawos")
READ_SIZE_CAP = 1024 * 1024
UNIT_RE = re.compile(r"^dclawos-[a-z0-9-]+(\.service)?$")
REQUEST_SIZE_CAP = 64 * 1024


def log(msg):
    print(f"dclawos-privileged: {msg}", flush=True)


def _is_under(path, prefix):
    return path == prefix or path.startswith(prefix + "/")


def op_read_file(params):
    path = params.get("path")
    if not isinstance(path, str) or not path:
        return False, "read-file requires a string 'path' param"
    real = os.path.realpath(path)
    if not any(_is_under(real, prefix) for prefix in READ_PREFIXES):
        return False, f"read-file path outside allowed prefixes: {path!r}"
    try:
        size = os.path.getsize(real)
    except OSError as exc:
        return False, f"read-file cannot stat: {exc}"
    if size > READ_SIZE_CAP:
        return False, "read-file file too large (>1MB)"
    try:
        with open(real, "r", encoding="utf-8", errors="replace") as handle:
            content = handle.read()
    except OSError as exc:
        return False, f"read-file cannot read: {exc}"
    return True, {"path": real, "content": content}


def _check_unit(params):
    unit = params.get("unit")
    if not isinstance(unit, str) or not UNIT_RE.match(unit):
        return None, (
            f"unit must match dclawos-* (got {unit!r}); "
            "only DclawOS-owned units are whitelisted")
    return unit, None


def op_service_status(params):
    unit, error = _check_unit(params)
    if error is not None:
        return False, error
    try:
        proc = subprocess.run(
            ["systemctl", "is-active", unit],
            capture_output=True, text=True, timeout=10)
    except FileNotFoundError:
        return False, "systemctl not available"
    except subprocess.TimeoutExpired:
        return False, "systemctl is-active timed out"
    if proc.returncode != 0:
        return False, (
            f"systemctl is-active failed ({proc.returncode}): "
            f"{proc.stderr.strip()}")
    return True, {"unit": unit, "active": proc.stdout.strip()}


def op_restart_service(params):
    unit, error = _check_unit(params)
    if error is not None:
        return False, error
    try:
        proc = subprocess.run(
            ["systemctl", "restart", unit],
            capture_output=True, text=True, timeout=30)
    except FileNotFoundError:
        return False, "systemctl not available"
    except subprocess.TimeoutExpired:
        return False, "systemctl restart timed out"
    if proc.returncode != 0:
        return False, (
            f"systemctl restart failed ({proc.returncode}): "
            f"{proc.stderr.strip()}")
    return True, {"unit": unit, "restarted": True}


PACKAGE_RE = re.compile(r"^[a-z0-9][a-z0-9.+-]*$")
SECRET_NAME_RE = re.compile(r"^[a-z0-9][a-z0-9_-]*$")
SECRETS_DIR = "/var/lib/dclawos/secrets"


def op_package_install(params):
    """Install one Debian package (Phase 3 module 1: agent may install).

    Ticket-gated like every mutating op. The package name is strictly
    validated (no version specs, no flags, no shell metacharacters);
    apt runs non-interactively with --no-install-recommends so an
    install cannot drag in a desktop's worth of recommends.
    """
    package = params.get("package")
    if not isinstance(package, str) or not PACKAGE_RE.match(package):
        return False, f"invalid package name: {package!r}"
    env = dict(os.environ)
    env["DEBIAN_FRONTEND"] = "noninteractive"
    try:
        proc = subprocess.run(
            ["apt-get", "install", "-y", "--no-install-recommends",
             package],
            capture_output=True, text=True, timeout=600, env=env)
    except FileNotFoundError:
        return False, "apt-get not available"
    except subprocess.TimeoutExpired:
        return False, "apt-get install timed out"
    if proc.returncode != 0:
        tail = (proc.stderr or "")[-500:]
        return False, f"apt-get install failed ({proc.returncode}): {tail}"
    return True, {"package": package, "installed": True}


def op_write_secret(params):
    """Store one agent secret (Phase 3 module 1).

    The value travels inside the broker request (local Unix socket,
    group-gated) and is written to a file owned by dclaw-agent 0600;
    it is NEVER stored in a ticket file (tickets hold only the params
    hash + summary), NEVER logged, and NEVER returned. The agent
    service reads its own secret files directly; there is no CLI get
    path by design. Directory is 0711 root-owned: the agent can open
    files it owns by name but cannot list the directory.
    """
    name = params.get("name")
    value = params.get("value")
    if not isinstance(name, str) or not SECRET_NAME_RE.match(name):
        return False, f"invalid secret name: {name!r}"
    if not isinstance(value, str) or not value:
        return False, "write-secret needs a non-empty string value"
    try:
        os.makedirs(SECRETS_DIR, exist_ok=True)
        os.chmod(SECRETS_DIR, 0o711)
    except OSError as exc:
        return False, f"cannot prepare secrets dir: {exc}"
    path = os.path.join(SECRETS_DIR, name)
    tmp = f"{path}.tmp.{os.getpid()}"
    try:
        with open(tmp, "w", encoding="utf-8") as handle:
            handle.write(value)
        try:
            import pwd
            uid = pwd.getpwnam("dclaw-agent").pw_uid
            os.chown(tmp, uid, -1)
        except (KeyError, OSError):
            log("write-secret: dclaw-agent user missing; "
                "leaving file root-owned")
        os.chmod(tmp, 0o600)
        os.replace(tmp, path)
    except OSError as exc:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        return False, f"write-secret failed: {exc}"
    return True, {"name": name, "stored": True}


OPERATIONS = {
    "read-file": op_read_file,
    "service-status": op_service_status,
    "restart-service": op_restart_service,
    "package-install": op_package_install,
    "write-secret": op_write_secret,
}


def execute(request):
    ticket_id = request.get("ticket_id")
    operation = request.get("operation")
    params = request.get("params")
    if not isinstance(ticket_id, str) or not isinstance(operation, str) \
            or not isinstance(params, dict):
        return {"ok": False, "error": "request needs ticket_id, operation, params"}
    try:
        ticket = ticketlib.load_ticket(ticket_id)
    except (ValueError, OSError, json.JSONDecodeError) as exc:
        return {"ok": False, "error": f"ticket unreadable: {exc}"}
    ok, error = ticketlib.validate_for_execution(ticket, operation, params)
    if not ok:
        if ticket.get("status") == "approved" \
                and ticketlib.is_expired(ticket):
            ticket["status"] = "expired"
            try:
                ticketlib.save_ticket(ticket)
            except OSError:
                pass
        log(f"refused ticket={ticket_id} operation={operation} reason={error}")
        return {"ok": False, "error": error}
    handler = OPERATIONS.get(operation)
    if handler is None:
        log(f"refused ticket={ticket_id} operation={operation} "
            "reason=not in whitelist")
        return {"ok": False,
                "error": f"operation not in whitelist: {operation!r}"}
    success, result = handler(params)
    if not success:
        log(f"failed ticket={ticket_id} operation={operation} "
            f"reason={result}")
        return {"ok": False, "error": result}
    ticket["status"] = "consumed"
    ticket["executed_at"] = int(time.time())
    ticket["result"] = "ok"
    try:
        ticketlib.save_ticket(ticket)
    except OSError as exc:
        log(f"warning: could not mark ticket consumed: {exc}")
    log(f"executed ticket={ticket_id} operation={operation}")
    return {"ok": True, "result": result}


class Handler(socketserver.StreamRequestHandler):
    def handle(self):
        try:
            line = self.rfile.readline(REQUEST_SIZE_CAP + 1)
        except OSError:
            return
        if not line or len(line) > REQUEST_SIZE_CAP:
            self._reply({"ok": False, "error": "request too large or empty"})
            return
        try:
            request = json.loads(line.decode("utf-8"))
        except (ValueError, UnicodeDecodeError):
            self._reply({"ok": False, "error": "request is not valid JSON"})
            return
        if not isinstance(request, dict):
            self._reply({"ok": False, "error": "request must be a JSON object"})
            return
        self._reply(execute(request))

    def _reply(self, payload):
        try:
            self.wfile.write(
                (json.dumps(payload) + "\n").encode("utf-8"))
            self.wfile.flush()
        except OSError:
            pass


class Server(socketserver.ThreadingMixIn, socketserver.UnixStreamServer):
    daemon_threads = True
    allow_reuse_address = True


def main():
    sock_path = ticketlib.socket_path()
    tickets = ticketlib.tickets_dir()
    # Exchange dir + socket: shared group (module 7) so the AI user
    # (dclaw-agent) and the human (dclaw) can both use the broker.
    ticketlib.ensure_dir(tickets)
    if os.path.exists(sock_path):
        try:
            mode = os.stat(sock_path).st_mode
        except OSError:
            mode = 0
        if stat.S_ISSOCK(mode):
            os.unlink(sock_path)
        else:
            log(f"refusing to unlink non-socket file at {sock_path}")
            return 1
    os.makedirs(os.path.dirname(sock_path) or ".", exist_ok=True)
    server = Server(sock_path, Handler)
    try:
        os.chmod(sock_path, 0o660)
    except OSError as exc:
        log(f"warning: socket perms: {exc}")
    ticketlib.set_shared_group(sock_path)
    # Smoke-test marker: the QEMU boot smoke greps the serial console
    # for this line (journald forwards it) to prove the broker is live.
    log(f"dclawos-privileged listening on {sock_path}")
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
