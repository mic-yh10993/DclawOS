#!/usr/bin/env python3
"""DclawOS settings app (Phase 2 module 3): self-built GUI settings.

Panels: General (window mode), AI & Model (provider / model / routing),
Skills & MCP (unified registry, module 9).
Every control writes DIRECTLY to the DclawOS GSettings schema — no HTTP
API, no intermediate service (the user-confirmed "native direct"
requirement, cards §3). The schema lives in
org.dclawos.settings (compiled at image build time by hook 1002).

Reuse notes (evaluation cards §3, step 0 retrieval):
- Panel organization (one page per panel, sidebar navigation) follows the
  gnome-control-center CcPanel organization PATTERN (panels/ directory);
  no gnome-control-center code is copied and the full app is not used.
- Direct-write calls follow the gnome-control-center pattern
  (panels/power/cc-power-panel.c:372 g_settings_set_boolean, :630/:637
  g_settings_set_uint): the calls themselves are plain Gio.Settings
  API, retargeted from GNOME schemas to the DclawOS own schema.
// reuse-check: gnome-control-center panels/* NOT copied, reason: only
  the organization pattern is reusable; every panel's content is new
  (DclawOS schema keys do not exist in GNOME).
// reuse-check: cc-power-panel.c g_settings_set_* adopted as call
  pattern only, reason: the pattern IS "GUI writes GSettings directly",
  which is exactly the user requirement; the write target changed.
"""
import json
import os
import sys
import threading

sys.path.insert(0, "/usr/local/lib/dclawos")
sys.path.insert(0, os.path.join(
    os.path.dirname(os.path.abspath(__file__)), "..", "lib", "dclawos"))

try:
    import registrylib
except ImportError:
    registrylib = None

try:
    import agentlib
except ImportError:
    agentlib = None

import gi

gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gio, GLib  # noqa: E402

SCHEMA_ID = "org.dclawos.settings"
CATALOG_PATH = "/usr/share/dclawos/engine/catalog.json"


def log(msg):
    print(f"dclawos-settings: {msg}", flush=True)


class SettingsApp(Gtk.Window):
    def __init__(self, settings):
        super().__init__(title="dclawos-settings")
        self.settings = settings
        self.set_default_size(900, 600)
        try:
            import theme
            theme.apply_theme()
        except ImportError:
            pass
        header = Gtk.HeaderBar()
        header.set_title("设置")
        header.set_subtitle("DclawOS 系统设置")
        header.set_show_close_button(True)
        self.set_titlebar(header)

        paned = Gtk.Paned(orientation=Gtk.Orientation.HORIZONTAL)
        self.add(paned)

        stack = Gtk.Stack()
        stack.set_transition_type(Gtk.StackTransitionType.SLIDE_LEFT_RIGHT)
        sidebar = Gtk.StackSidebar()
        sidebar.set_stack(stack)
        paned.pack1(sidebar, False, False)
        paned.pack2(stack, True, False)

        stack.add_titled(self.build_general_panel(), "general", "通用")
        stack.add_titled(self.build_ai_panel(), "ai", "AI 与模型")
        stack.add_titled(self.build_skills_panel(), "skills", "Skills 与 MCP")
        stack.add_titled(self.build_secrets_panel(), "secrets", "密钥")

    def labeled_row(self, label_text, widget):
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        row.set_border_width(6)
        label = Gtk.Label(label=label_text)
        label.set_halign(Gtk.Align.START)
        label.set_size_request(140, -1)
        row.pack_start(label, False, False, 0)
        row.pack_start(widget, True, True, 0)
        return row

    def build_general_panel(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        box.set_border_width(12)

        mode_combo = Gtk.ComboBoxText()
        mode_combo.append("fullscreen", "全屏（除任务栏外全屏）")
        mode_combo.append("windowed", "窗口模式（不自动最大化）")
        current = self.settings.get_string("window-mode")
        mode_combo.set_active_id(
            current if current in ("fullscreen", "windowed")
            else "fullscreen")
        mode_combo.connect(
            "changed",
            lambda combo: self.settings.set_string(
                "window-mode", combo.get_active_id() or "fullscreen"))
        box.pack_start(
            self.labeled_row("应用窗口模式", mode_combo), False, False, 0)

        note = Gtk.Label(
            label="说明：全屏模式下从任务栏切换应用时窗口最大化，任务栏"
                  "通过底部保留区始终可见；窗口模式则只激活不最大化。")
        note.set_line_wrap(True)
        note.set_halign(Gtk.Align.START)
        box.pack_start(note, False, False, 0)

        # Phase 3 module 4: full-access toggle. The agent service reads
        # this key (agentlib.full_access_enabled); the GUI only writes
        # it — the service never writes its own permission.
        fa_switch = Gtk.Switch()
        fa_switch.set_active(self.settings.get_boolean("agent-full-access"))
        fa_switch.connect(
            "notify::active",
            lambda sw, _pspec: self.settings.set_boolean(
                "agent-full-access", sw.get_active()))
        box.pack_start(
            self.labeled_row("Agent 完全访问（无限制）", fa_switch),
            False, False, 0)
        fa_note = Gtk.Label(
            label="警告：开启后 agent 的所有工具调用（含删文件、工作区外"
                  "操作、装软件）不再弹窗等待人工批准，自动通过；但每次"
                  "调用仍会创建票据并记入事件日志。默认关闭。")
        fa_note.set_line_wrap(True)
        fa_note.set_halign(Gtk.Align.START)
        box.pack_start(fa_note, False, False, 0)
        return box

    def load_catalog(self):
        """Read the routing catalog JSON; None when the engine is absent.

        The catalog is generated at image build time by the routing
        engine hook (module 4) from the vendored provider registry.
        A missing or unreadable catalog is NOT an error: the panel
        falls back to free-text entries (module 3 behavior).
        """
        try:
            with open(CATALOG_PATH, "r", encoding="utf-8") as handle:
                data = json.load(handle)
            providers = data.get("providers")
            if not isinstance(providers, list):
                return None
            return providers
        except (OSError, ValueError):
            return None

    def build_ai_panel(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        box.set_border_width(12)

        catalog = self.load_catalog()
        if catalog:
            providers_by_id = {}
            for entry in catalog:
                if isinstance(entry, dict) and isinstance(
                        entry.get("id"), str):
                    providers_by_id[entry["id"]] = entry
            provider_combo = Gtk.ComboBoxText()
            for pid in providers_by_id:
                provider_combo.append(pid, pid)
            current_provider = self.settings.get_string("ai-provider")
            if current_provider and current_provider not in providers_by_id:
                provider_combo.prepend(
                    current_provider,
                    current_provider + "（未在目录中）")
            if current_provider:
                provider_combo.set_active_id(current_provider)

            model_combo = Gtk.ComboBoxText()

            def refresh_models(pid):
                model_combo.remove_all()
                entry = providers_by_id.get(pid)
                models = entry.get("models") if isinstance(entry, dict) \
                    else None
                ids = [m["id"] for m in (models or [])
                       if isinstance(m, dict)
                       and isinstance(m.get("id"), str)]
                for mid in ids:
                    model_combo.append(mid, mid)
                current_model = self.settings.get_string("ai-model")
                if current_model and current_model not in ids:
                    model_combo.prepend(
                        current_model,
                        current_model + "（未在目录中）")
                if current_model:
                    model_combo.set_active_id(current_model)

            def on_provider_changed(combo):
                pid = combo.get_active_id()
                if pid:
                    self.settings.set_string("ai-provider", pid)
                    refresh_models(pid)

            provider_combo.connect("changed", on_provider_changed)
            model_combo.connect(
                "changed",
                lambda combo: self.settings.set_string(
                    "ai-model", combo.get_active_id() or ""))
            refresh_models(current_provider)
            box.pack_start(
                self.labeled_row("AI 供应商", provider_combo),
                False, False, 0)
            box.pack_start(
                self.labeled_row("AI 模型", model_combo),
                False, False, 0)
        else:
            provider = Gtk.Entry()
            provider.set_text(self.settings.get_string("ai-provider"))
            provider.connect(
                "changed",
                lambda entry: self.settings.set_string(
                    "ai-provider", entry.get_text()))
            box.pack_start(
                self.labeled_row("AI 供应商", provider), False, False, 0)

            model = Gtk.Entry()
            model.set_text(self.settings.get_string("ai-model"))
            model.connect(
                "changed",
                lambda entry: self.settings.set_string(
                    "ai-model", entry.get_text()))
            box.pack_start(
                self.labeled_row("AI 模型", model), False, False, 0)

        routing = Gtk.ComboBoxText()
        routing.append("auto", "自动（路由引擎选择）")
        routing.append("manual", "手动（固定供应商与模型）")
        current = self.settings.get_string("routing-mode")
        routing.set_active_id(
            current if current in ("auto", "manual") else "auto")
        routing.connect(
            "changed",
            lambda combo: self.settings.set_string(
                "routing-mode", combo.get_active_id() or "auto"))
        box.pack_start(
            self.labeled_row("路由模式", routing), False, False, 0)

        note = Gtk.Label(
            label="说明：供应商与模型下拉来自路由引擎目录 "
                  "(/usr/share/dclawos/engine/catalog.json，模块 4 编译生成)；"
                  "目录缺失时回退自由文本输入。")
        note.set_line_wrap(True)
        note.set_halign(Gtk.Align.START)
        box.pack_start(note, False, False, 0)
        return box

    def build_skills_panel(self):
        """Skills + MCP unified management (module 9, Q3: GUI, no TUI)."""
        if registrylib is None:
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            box.set_border_width(12)
            label = Gtk.Label(label="注册表库不可用（registrylib 缺失），"
                                   "无法管理 Skills 与 MCP。")
            label.set_line_wrap(True)
            label.set_halign(Gtk.Align.START)
            box.pack_start(label, False, False, 0)
            return box

        scrolled = Gtk.ScrolledWindow()
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        box.set_border_width(12)
        scrolled.add(box)

        note = Gtk.Label(
            label="说明：Skills、MCP 与连接器在此统一管理（Q3，不走 TUI）。"
                  "MCP/连接器调用的审批走票据 broker（agent 服务已接入）。"
                  "MCP 环境变量不在此页编辑（常为密钥）：需要密钥时在"
                  "「密钥」页保存，注册表 env 写 secret:<名称> 引用。")
        note.set_line_wrap(True)
        note.set_halign(Gtk.Align.START)
        box.pack_start(note, False, False, 0)

        self.registry_status = Gtk.Label(label="")
        self.registry_status.set_halign(Gtk.Align.START)
        box.pack_start(self.registry_status, False, False, 0)

        self.skills_store, skills_scroll = self._registry_tree(
            ("名称", "ID", "路径", "启用", "许可证"), (0, 2))
        skills_label = Gtk.Label(label="Skills")
        skills_label.set_halign(Gtk.Align.START)
        box.pack_start(skills_label, False, False, 0)
        box.pack_start(skills_scroll, True, True, 0)
        box.pack_start(self._registry_buttons(
            (("添加 Skill", self.on_add_skill),
             ("删除 Skill", self.on_remove_skill),
             ("切换启用", self.on_toggle_skill))),
            False, False, 0)
        self.skills_scroll = skills_scroll

        self.servers_store, servers_scroll = self._registry_tree(
            ("名称", "ID", "命令与参数", "启用", "许可证"), (0, 2))
        servers_label = Gtk.Label(label="MCP 服务器")
        servers_label.set_halign(Gtk.Align.START)
        box.pack_start(servers_label, False, False, 0)
        box.pack_start(servers_scroll, True, True, 0)
        box.pack_start(self._registry_buttons(
            (("添加 MCP 服务器", self.on_add_server),
             ("删除 MCP 服务器", self.on_remove_server),
             ("切换启用", self.on_toggle_server))),
            False, False, 0)
        self.servers_scroll = servers_scroll

        self.connectors_store, connectors_scroll = self._registry_tree(
            ("名称", "ID", "命令与参数", "启用", "许可证"), (0, 2))
        connectors_label = Gtk.Label(label="连接器")
        connectors_label.set_halign(Gtk.Align.START)
        box.pack_start(connectors_label, False, False, 0)
        box.pack_start(connectors_scroll, True, True, 0)
        box.pack_start(self._registry_buttons(
            (("添加连接器", self.on_add_connector),
             ("删除连接器", self.on_remove_connector),
             ("切换启用", self.on_toggle_connector))),
            False, False, 0)
        self.connectors_scroll = connectors_scroll

        self.refresh_registry()
        return scrolled

    def _registry_tree(self, titles, expand_indices):
        store = Gtk.ListStore(str, str, str, str, str)
        tree = Gtk.TreeView(model=store)
        for index, title in enumerate(titles):
            column = Gtk.TreeViewColumn(
                title, Gtk.CellRendererText(), text=index)
            column.set_resizable(True)
            if index in expand_indices:
                column.set_expand(True)
            tree.append_column(column)
        scrolled = Gtk.ScrolledWindow()
        scrolled.set_min_content_height(150)
        scrolled.add(tree)
        return store, scrolled

    def _registry_buttons(self, buttons):
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        for label, handler in buttons:
            button = Gtk.Button(label=label)
            button.connect("clicked", handler)
            row.pack_start(button, False, False, 0)
        return row

    def _selected_id(self, tree):
        selection = tree.get_selection()
        model, tree_iter = selection.get_selected()
        if tree_iter is None:
            return None
        return model[tree_iter][1]

    def refresh_registry(self):
        try:
            data, skipped = registrylib.load_registry()
        except ValueError as exc:
            self.registry_status.set_text(f"注册表读取失败：{exc}")
            self.skills_store.clear()
            self.servers_store.clear()
            self.connectors_store.clear()
            return
        self.skills_store.clear()
        for entry in data["skills"]:
            self.skills_store.append((
                entry.get("name", ""), entry.get("id", ""),
                entry.get("path", ""),
                "是" if entry.get("enabled") else "否",
                entry.get("license", "")))
        self.servers_store.clear()
        for entry in data["mcp_servers"]:
            command = entry.get("command", "")
            args = " ".join(entry.get("args", []))
            shown = f"{command} {args}".strip()
            self.servers_store.append((
                entry.get("name", ""), entry.get("id", ""), shown,
                "是" if entry.get("enabled") else "否",
                entry.get("license", "")))
        self.connectors_store.clear()
        for entry in data["connectors"]:
            command = entry.get("command", "")
            args = " ".join(entry.get("args", []))
            shown = f"{command} {args}".strip()
            self.connectors_store.append((
                entry.get("name", ""), entry.get("id", ""), shown,
                "是" if entry.get("enabled") else "否",
                entry.get("license", "")))
        status = (f"Skills {len(data['skills'])} 个，"
                  f"MCP 服务器 {len(data['mcp_servers'])} 个，"
                  f"连接器 {len(data['connectors'])} 个")
        if skipped:
            status += f"（{skipped} 条无效记录已跳过）"
        self.registry_status.set_text(status)

    def _entry_row(self, area, label_text):
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        row.pack_start(Gtk.Label(label=label_text), False, False, 0)
        entry = Gtk.Entry()
        row.pack_start(entry, True, True, 0)
        area.pack_start(row, False, False, 0)
        return entry

    def _confirm(self, text):
        dialog = Gtk.MessageDialog(
            transient_for=self,
            message_type=Gtk.MessageType.QUESTION,
            buttons=Gtk.ButtonsType.OK_CANCEL,
            text=text)
        response = dialog.run()
        dialog.destroy()
        return response == Gtk.ResponseType.OK

    def _error(self, text):
        dialog = Gtk.MessageDialog(
            transient_for=self,
            message_type=Gtk.MessageType.ERROR,
            buttons=Gtk.ButtonsType.OK,
            text=text)
        dialog.run()
        dialog.destroy()

    def _add_dialog(self, kind):
        """Add-entry dialog loop. Returns True if something was added."""
        titles = {"skill": "添加 Skill", "server": "添加 MCP 服务器",
                  "connector": "添加连接器"}
        title = titles.get(kind, "添加")
        dialog = Gtk.Dialog(title=title, transient_for=self,
                            flags=Gtk.DialogFlags.MODAL)
        dialog.add_button("取消", Gtk.ResponseType.CANCEL)
        dialog.add_button("添加", Gtk.ResponseType.OK)
        area = dialog.get_content_area()
        area.set_border_width(8)
        name = self._entry_row(area, "名称：")
        entry_id = self._entry_row(area, "ID（小写字母/数字/_/-）：")
        if kind == "skill":
            path_or_cmd = self._entry_row(area, "路径：")
            args_entry = None
        else:
            path_or_cmd = self._entry_row(area, "命令：")
            args_entry = self._entry_row(area, "参数（空格分隔）：")
        description = self._entry_row(area, "描述：")
        license_entry = self._entry_row(area, "许可证：")
        dialog.show_all()
        added = False
        while dialog.run() == Gtk.ResponseType.OK:
            entry = {
                "id": entry_id.get_text().strip(),
                "name": name.get_text().strip(),
                "description": description.get_text().strip(),
                "license": license_entry.get_text().strip(),
            }
            if kind == "skill":
                entry["path"] = path_or_cmd.get_text().strip()
            else:
                entry["command"] = path_or_cmd.get_text().strip()
                entry["args"] = args_entry.get_text().split()
            if not entry["license"]:
                if not self._confirm(
                        "未填写许可证：该包未声明许可证，仍要添加吗？"):
                    continue
            try:
                data, _skipped = registrylib.load_registry()
                if kind == "skill":
                    registrylib.add_skill(data, entry)
                elif kind == "server":
                    registrylib.add_server(data, entry)
                else:
                    registrylib.add_connector(data, entry)
                registrylib.save_registry(data)
            except ValueError as exc:
                self._error(f"添加失败：{exc}")
                continue
            added = True
            break
        dialog.destroy()
        if added:
            self.refresh_registry()
        return added

    def on_add_skill(self, _button):
        self._add_dialog("skill")

    def on_add_server(self, _button):
        self._add_dialog("server")

    def on_add_connector(self, _button):
        self._add_dialog("connector")

    def build_secrets_panel(self):
        """Secret store page (Phase 3 module 2).

        Writes go through the privileged broker's write-secret op,
        gated by a ticket (approval popup or full-access auto-approval)
        — the same gate the agent service uses. Values are never shown
        back, never logged, and never stored in the registry: the
        registry env references them as secret:<name>.

        Why files, not libsecret: the agent service runs as the
        dclaw-agent system user, which has no login session and no
        unlocked keyring; a root broker cannot unlock the human user's
        keyring either. Broker-written 0600 files owned by dclaw-agent
        are the equivalent store for a service user.
        """
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        box.set_border_width(12)
        if agentlib is None:
            label = Gtk.Label(label="agentlib 不可用，无法保存密钥。")
            label.set_line_wrap(True)
            label.set_halign(Gtk.Align.START)
            box.pack_start(label, False, False, 0)
            return box
        note = Gtk.Label(
            label="说明：密钥只写不读，保存后无法查看原文，只能被 agent "
                  "服务通过 secret:<名称> 引用。保存需要审批（弹出审批"
                  "窗口确认，或开启完全访问后自动通过）。")
        note.set_line_wrap(True)
        note.set_halign(Gtk.Align.START)
        box.pack_start(note, False, False, 0)
        self.secret_name = Gtk.Entry()
        box.pack_start(self.labeled_row("名称（小写字母/数字/_/-）：",
                                        self.secret_name), False, False, 0)
        self.secret_value = Gtk.Entry()
        self.secret_value.set_visibility(False)
        box.pack_start(self.labeled_row("密钥值：", self.secret_value),
                       False, False, 0)
        self.secret_status = Gtk.Label(label="")
        self.secret_status.set_halign(Gtk.Align.START)
        self.secret_status.set_line_wrap(True)
        box.pack_start(self.secret_status, False, False, 0)
        save_btn = Gtk.Button(label="保存密钥（需审批）")
        save_btn.connect("clicked", self.on_save_secret)
        box.pack_start(save_btn, False, False, 0)
        return box

    def on_save_secret(self, _button):
        name = self.secret_name.get_text().strip()
        value = self.secret_value.get_text()
        if not name or not value:
            self.secret_status.set_text("名称与密钥值都不能为空。")
            return
        self.secret_status.set_text("等待审批……")
        self.secret_value.set_text("")

        def work():
            # The broker validates the ticket by params hash, so the
            # approval params and the execution params must be the
            # identical dict (same as dclawos-secret). The value lives
            # only in this process's memory; the ticket stores a hash.
            params = {"name": name, "value": value}
            try:
                verdict, ticket_id = agentlib.request_approval(
                    "write-secret", params,
                    f"保存密钥 {name}")
                if verdict != "approved":
                    GLib.idle_add(self.secret_status.set_text,
                                  f"未保存：审批结果 {verdict}。")
                    return
                reply = agentlib.broker_execute(
                    ticket_id, "write-secret", params)
                if reply.get("ok"):
                    GLib.idle_add(self.secret_status.set_text,
                                  f"密钥 {name} 已保存。")
                else:
                    GLib.idle_add(self.secret_status.set_text,
                                  f"保存失败：{reply.get('error')}")
            except Exception as exc:  # noqa: BLE001 - surface to the user
                GLib.idle_add(self.secret_status.set_text,
                              f"保存失败：{exc}")

        threading.Thread(target=work, daemon=True).start()

    def _remove_selected(self, kind, tree):
        entry_id = self._selected_id(tree)
        if entry_id is None:
            self._error("请先选择一行")
            return
        labels = {"skill": "Skill", "server": "MCP 服务器",
                  "connector": "连接器"}
        keys = {"skill": "skills", "server": "mcp_servers",
                "connector": "connectors"}
        label = labels.get(kind, kind)
        if not self._confirm(f"确定删除{label} {entry_id} 吗？"):
            return
        try:
            data, _skipped = registrylib.load_registry()
            registrylib.remove_entry(data, keys[kind], entry_id)
            registrylib.save_registry(data)
        except ValueError as exc:
            self._error(f"删除失败：{exc}")
            return
        self.refresh_registry()

    def on_remove_skill(self, _button):
        self._remove_selected("skill", self.skills_scroll.get_child())

    def on_remove_server(self, _button):
        self._remove_selected("server", self.servers_scroll.get_child())

    def on_remove_connector(self, _button):
        self._remove_selected("connector", self.connectors_scroll.get_child())

    def _toggle_selected(self, kind, tree):
        entry_id = self._selected_id(tree)
        if entry_id is None:
            self._error("请先选择一行")
            return
        try:
            data, _skipped = registrylib.load_registry()
            key = {"skill": "skills", "server": "mcp_servers",
                   "connector": "connectors"}[kind]
            current = None
            for entry in data[key]:
                if entry.get("id") == entry_id:
                    current = entry
                    break
            if current is None:
                raise ValueError(f"找不到 {entry_id!r}")
            registrylib.set_enabled(
                data, key, entry_id, not current.get("enabled", True))
            registrylib.save_registry(data)
        except ValueError as exc:
            self._error(f"切换失败：{exc}")
            return
        self.refresh_registry()

    def on_toggle_skill(self, _button):
        self._toggle_selected("skill", self.skills_scroll.get_child())

    def on_toggle_server(self, _button):
        self._toggle_selected("server", self.servers_scroll.get_child())

    def on_toggle_connector(self, _button):
        self._toggle_selected("connector",
                              self.connectors_scroll.get_child())


def main():
    if len(sys.argv) > 1 and sys.argv[1] in ("-h", "--help"):
        print("usage: dclawos-settings (writes org.dclawos.settings "
              "directly)")
        return 0
    try:
        settings = Gio.Settings.new(SCHEMA_ID)
    except Exception as exc:
        print(f"dclawos-settings: schema {SCHEMA_ID} unavailable: {exc}",
              file=sys.stderr)
        print("dclawos-settings: the image build compiles this schema "
              "(hook 1002); a missing schema means a broken image.",
              file=sys.stderr)
        return 1
    log("dclawos-settings started (Phase 2 module 3: direct-write GUI)")
    win = SettingsApp(settings)
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()
    return 0


if __name__ == "__main__":
    sys.exit(main())
