#!/usr/bin/env python3
"""DclawOS settings app (Phase 2 module 3): self-built GUI settings.

Panels: General (window mode), AI & Model (provider / model / routing),
Skills & MCP (unified registry, module 9).
Every control writes DIRECTLY to the DclawOS settings store — no HTTP
API, no intermediate service (the user-confirmed "native direct"
requirement, cards §3).

P5-M7 (user decision 2026-10-31, option B: "设置改存双方共读的配置
文件"): the store is the SHARED settings file
(/var/lib/dclawos/settings/agent-settings.json) via settingslib — the same
file the agent daemon reads, so what the human sets here is what
the agent sees (GSettings is per-user dconf; the daemon could
never see this app's writes). The org.dclawos.settings schema
(compiled at image build time by hook 1002) remains ONLY as the
first-run seed source: when the shared file is absent, main()
seeds it from the current GSettings values, then the file is
authoritative. The panels talk to a Gio.Settings-shaped adapter
(SharedSettings below) so panel code is unchanged in shape; the
window re-reads the file on focus-in, so agent-made changes
(settings_set) show up without a restart.

Reuse notes (evaluation cards §3, step 0 retrieval):
- Panel organization (one page per panel, sidebar navigation) follows the
  gnome-control-center CcPanel organization PATTERN (panels/ directory);
  no gnome-control-center code is copied and the full app is not used.
- Direct-write calls follow the gnome-control-center pattern
  (panels/power/cc-power-panel.c:372 g_settings_set_boolean, :630/:637
  g_settings_set_uint): the calls themselves are plain Gio.Settings
  API, retargeted from GNOME schemas to the DclawOS own schema.
// reuse-check: gnome-control-center panels/* NOT copied, reason: only
  the organization pattern is reusable; every panel's content is new
  (DclawOS schema keys do not exist in GNOME).
// reuse-check: cc-power-panel.c g_settings_set_* adopted as call
  pattern only, reason: the pattern IS "GUI writes GSettings directly",
  which is exactly the user requirement; the write target changed.
"""
import json
import os
import sys
import threading

sys.path.insert(0, "/usr/local/lib/dclawos")
sys.path.insert(0, os.path.join(
    os.path.dirname(os.path.abspath(__file__)), "..", "lib", "dclawos"))

try:
    import registrylib
except ImportError:
    registrylib = None

try:
    import settingslib
except ImportError:
    settingslib = None

try:
    import agentlib
except ImportError:
    agentlib = None

# Phase 6 M2: model settings WebView host dependencies.
try:
    import bridgeprotocol
except ImportError:
    bridgeprotocol = None

try:
    import llmlib
except ImportError:
    llmlib = None

try:
    import modellib
except ImportError:
    modellib = None

try:
    import usagelib
except ImportError:
    usagelib = None

import gi

gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gio, GLib  # noqa: E402

SCHEMA_ID = "org.dclawos.settings"
CATALOG_PATH = "/usr/share/dclawos/engine/catalog.json"
# Phase 6 M2: local WebView page (offline, no external resources).
MODEL_PAGE_PATH = "/usr/share/dclawos/model-settings.html"


def log(msg):
    print(f"dclawos-settings: {msg}", flush=True)


class SharedSettings:
    """Gio.Settings-shaped adapter over settingslib (P5-M7).

    Only the four accessors the panels use. The suspend flag makes
    focus-refresh syncing write-free: pushing store values INTO
    widgets fires their changed signals, whose handlers call
    set_* — while suspended those calls are swallowed, so a
    refresh can never echo a write back into the store.
    """

    def __init__(self):
        self._suspended = False

    def begin_sync(self):
        self._suspended = True

    def end_sync(self):
        self._suspended = False

    def get_string(self, key):
        return settingslib.get_setting(key)

    def get_boolean(self, key):
        return bool(settingslib.get_setting(key))

    def set_string(self, key, value):
        if not self._suspended:
            settingslib.set_setting(key, value)
        return True

    def set_boolean(self, key, value):
        if not self._suspended:
            settingslib.set_setting(key, bool(value))
        return True


def migrate_gsettings_once():
    """First-run seed (P5-M7): when the shared settings file does
    not exist yet, create it from the human's current GSettings
    values (schema defaults when a key was never touched). After
    this, the file is authoritative and GSettings is untouched.
    Best effort throughout: any failure leaves defaults in charge
    and is logged, never fatal to the GUI."""
    try:
        if settingslib.file_exists():
            return
    except Exception:  # noqa: BLE001 - best effort migration
        return
    seed = {}
    try:
        gio_settings = Gio.Settings.new(SCHEMA_ID)
        for key in ("window-mode", "ai-provider", "ai-model",
                    "routing-mode"):
            seed[key] = gio_settings.get_string(key)
        for key in ("taskbar-autohide", "ui-dark",
                    "agent-full-access"):
            seed[key] = gio_settings.get_boolean(key)
    except Exception:  # noqa: BLE001 - schema absent: defaults seed
        seed = {}
    try:
        if settingslib.seed(seed):
            log("migrated GSettings values into the shared "
                "settings file (one-time, P5-M7)")
    except Exception as exc:  # noqa: BLE001 - logged, defaults apply
        log(f"settings seed failed (defaults apply): {exc}")


class SettingsApp(Gtk.Window):
    def __init__(self, settings):
        super().__init__(title="dclawos-settings")
        self.settings = settings
        self.set_default_size(900, 600)
        try:
            import theme
            theme.apply_theme()
        except ImportError:
            pass
        header = Gtk.HeaderBar()
        header.set_title("设置")
        header.set_subtitle("DclawOS 系统设置")
        header.set_show_close_button(True)
        self.set_titlebar(header)

        paned = Gtk.Paned(orientation=Gtk.Orientation.HORIZONTAL)
        self.add(paned)

        stack = Gtk.Stack()
        stack.set_transition_type(Gtk.StackTransitionType.SLIDE_LEFT_RIGHT)
        sidebar = Gtk.StackSidebar()
        sidebar.set_stack(stack)
        paned.pack1(sidebar, False, False)
        paned.pack2(stack, True, False)

        stack.add_titled(self.build_general_panel(), "general", "通用")
        stack.add_titled(self.build_ai_panel(), "ai", "AI 与模型")
        stack.add_titled(self.build_skills_panel(), "skills", "Skills 与 MCP")
        stack.add_titled(self.build_secrets_panel(), "secrets", "密钥")
        stack.add_titled(self.build_channels_panel(), "channels", "渠道")
        stack.add_titled(self.build_model_panel(), "model", "模型设置")
        # P5-M7: the agent can change settings too (settings_set).
        # Re-read the shared file whenever this window gains focus
        # so agent-made changes appear without a restart. Writes
        # are per-key read-modify-write on both sides, so a refresh
        # never fights a concurrent edit of a different key.
        self.connect("focus-in-event", self._on_focus_in)

    def _on_focus_in(self, _window, _event):
        self._refresh_from_store()
        # Phase 6 M2: the model WebView also re-reads shared storage
        # on focus (in addition to bus push, below).
        self._push_model_event("settings", {"reason": "focus"})
        return False

    # ------------------------------------------------ Phase 6 M2 host
    # Model settings WebView host. The page is UNTRUSTED: every
    # message is validated by bridgeprotocol (allowlist, surface,
    # secret rules) and dispatched ONLY to the typed handlers in
    # _model_dispatch. The host never evals page code; replies go
    # back as JSON data for the page's __dclawosReceive function.
    # // reuse-check: bridge envelope handling ADOPTED from
    #   bridgeprotocol (validate_hello / validate_command /
    #   make_reply / make_event / strip rules); secret writes reuse
    #   this app's existing broker flow (_store_secret, the same
    #   approval path as the secrets page) — no new secret channel.

    def build_model_panel(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        try:
            gi.require_version("WebKit2", "4.1")
            from gi.repository import WebKit2
        except (ImportError, ValueError) as exc:
            label = Gtk.Label(
                label=f"WebKitGTK 4.1 不可用（{exc}），模型设置 WebView "
                      "无法加载；原有「AI 与模型」面板仍可使用基础设置。")
            label.set_line_wrap(True)
            label.set_halign(Gtk.Align.START)
            box.pack_start(label, False, False, 0)
            self.model_webview = None
            return box
        manager = WebKit2.UserContentManager()
        manager.register_script_message_handler("dclawos")
        manager.connect("script-message-received::dclawos",
                        self._on_bridge_message)
        webview = WebKit2.WebView()
        try:
            webview = WebKit2.WebView.new_with_user_content_manager(
                manager)
        except Exception:  # noqa: BLE001 - older binding shape
            pass
        self.model_webview = webview
        if os.path.exists(MODEL_PAGE_PATH):
            webview.load_uri("file://" + MODEL_PAGE_PATH)
        else:
            webview.load_html(
                "<html><body><p>模型设置页面资源缺失："
                + MODEL_PAGE_PATH + "</p></body></html>", "file:///")
        box.pack_start(webview, True, True, 0)
        # Push: subscribe to the M1 event bus; agent-side changes
        # (settings/model/task events) are forwarded to the page,
        # which re-reads the shared stores. This is subscription
        # lifecycle (M1 semantics), not a polling timer.
        try:
            import eventbus
            self._model_subscriber = eventbus.EventSubscriber(
                self._on_bus_event_for_model).start()
        except Exception as exc:  # noqa: BLE001 - push is additive
            log(f"model page event subscription unavailable: {exc}")
            self._model_subscriber = None
        return box

    def _on_bus_event_for_model(self, event):
        try:
            data = event.get("data") or {}
            if isinstance(data, dict) and data.get("display") is False:
                return  # bus-only signal, not a display event
            self._push_model_event(event.get("type", "system"),
                                   {"summary": event.get("summary", "")})
        except Exception:  # noqa: BLE001 - forwarding is additive
            pass

    def _push_model_event(self, event_type, data):
        if getattr(self, "model_webview", None) is None \
                or bridgeprotocol is None:
            return
        try:
            message = bridgeprotocol.make_event(event_type, data)
        except Exception:  # noqa: BLE001
            return
        self._send_to_page(message)

    def _send_to_page_raw_js(self, script):
        webview = getattr(self, "model_webview", None)
        if webview is None:
            return

        def _do():
            try:
                if hasattr(webview, "evaluate_javascript"):
                    webview.evaluate_javascript(
                        script, -1, None, None, None, None)
                else:
                    webview.run_javascript(script, None, None, None)
            except Exception:  # noqa: BLE001
                pass
            return False

        GLib.idle_add(_do)

    def _send_to_page(self, message):
        webview = getattr(self, "model_webview", None)
        if webview is None:
            return
        script = "window.__dclawosReceive && window.__dclawosReceive(" \
            + json.dumps(message, ensure_ascii=False) + ");"

        def _do():
            try:
                if hasattr(webview, "evaluate_javascript"):
                    webview.evaluate_javascript(
                        script, -1, None, None, None, None)
                else:
                    webview.run_javascript(script, None, None, None)
            except Exception:  # noqa: BLE001 - page may be reloading
                pass
            return False

        GLib.idle_add(_do)

    def _on_bridge_message(self, _manager, js_result):
        if bridgeprotocol is None:
            return
        try:
            try:
                value = js_result.get_js_value()
                text = value.to_string()
            except Exception:  # noqa: BLE001 - older binding shape
                text = js_result.to_string()
            message = json.loads(text)
        except Exception:  # noqa: BLE001 - untrusted input
            return
        if isinstance(message, dict) and message.get("kind") == "hello":
            try:
                bridgeprotocol.validate_hello(message)
            except bridgeprotocol.BridgeError as exc:
                self._send_to_page(exc.to_error(None))
                return
            self._send_to_page(
                bridgeprotocol.make_hello_ack("settings"))
            # Dark palette for the page (UI-RULES token set).
            try:
                if settingslib is not None and \
                        settingslib.get_setting("ui-dark"):
                    self._send_to_page_raw_js(
                        "document.body.classList.add('dark');")
            except Exception:  # noqa: BLE001
                pass
            return
        try:
            command = bridgeprotocol.validate_command(
                message, "settings")
        except bridgeprotocol.BridgeError as exc:
            request_id = message.get("id") if isinstance(
                message, dict) else None
            self._send_to_page(exc.to_error(request_id))
            return
        verb = command["command"]
        params = command["params"]
        request_id = command["id"]
        if verb in ("model.test", "secret.set"):
            # Potentially slow (real request / human approval):
            # run off the GTK thread, reply when done.
            threading.Thread(
                target=self._bridge_dispatch_async,
                args=(request_id, verb, params), daemon=True).start()
            return
        self._bridge_dispatch_reply(request_id, verb, params)

    def _bridge_dispatch_async(self, request_id, verb, params):
        self._bridge_dispatch_reply(request_id, verb, params)

    def _bridge_dispatch_reply(self, request_id, verb, params):
        try:
            result = self._model_dispatch(verb, params)
        except Exception as exc:  # noqa: BLE001 - typed error reply
            self._send_to_page(bridgeprotocol.make_error(
                request_id, "handler_error", str(exc)[:500]))
            return
        self._send_to_page(bridgeprotocol.make_reply(
            request_id, result))

    def _catalog_providers(self):
        catalog = self.load_catalog() or []
        return catalog

    def _model_catalog_result(self):
        if registrylib is None:
            raise ValueError("registrylib 不可用")
        data, _skipped = registrylib.load_registry()
        merged = registrylib.merged_providers(
            self._catalog_providers(), data)
        keys = llmlib.available_keys() if llmlib is not None else {}
        by_id = {p["id"]: p for p in self._catalog_providers()}
        for entry in merged:
            entry["key_configured"] = entry["id"] in keys
            source = by_id.get(entry["id"])
            entry["catalog_models"] = (
                source.get("models", []) if source else [])
        return {"providers": merged}

    def _save_registry_and_notify(self, data, summary):
        registrylib.save_registry(data)
        if agentlib is not None:
            try:
                agentlib.log_event("model", summary)
            except Exception:  # noqa: BLE001 - event is additive
                pass

    def _model_dispatch(self, verb, params):
        """Typed host handlers for the settings surface. Raises
        ValueError with a readable message on bad input; nothing
        here returns a secret value."""
        if verb == "ping":
            return {"pong": True}
        if verb == "hello":
            return bridgeprotocol.make_hello_ack("settings")
        if verb == "settings.get":
            if settingslib is None:
                raise ValueError("settingslib 不可用")
            key = params.get("key")
            if key:
                return {"key": key,
                        "value": settingslib.get_setting(key)}
            return {"settings": settingslib.load_settings()}
        if verb == "settings.set":
            if settingslib is None:
                raise ValueError("settingslib 不可用")
            key = params.get("key")
            if not isinstance(key, str) or "value" not in params:
                raise ValueError("settings.set 需要 key 与 value")
            settingslib.set_setting(key, params["value"])
            if agentlib is not None:
                try:
                    agentlib.log_event(
                        "settings", f"settings {key} updated via "
                        "model/settings host")
                except Exception:  # noqa: BLE001
                    pass
            return {"key": key, "value": params["value"]}
        if verb == "secret.set":
            name = params.get("name")
            value = params.get("value")
            if not isinstance(name, str) or not name.startswith(
                    "llm-") or not isinstance(value, str) or not value:
                raise ValueError(
                    "secret.set 只接受 llm-<供应商> 名称与非空密钥值")
            # Reuse the secrets page broker flow synchronously here
            # (this handler already runs on a worker thread for
            # secret.set): approval + broker write-secret, value
            # never echoed in the reply.
            import threading as _threading
            done = _threading.Event()
            holder = {}

            def _work():
                try:
                    broker_params = {"name": name, "value": value}
                    verdict, ticket_id = agentlib.request_approval(
                        "write-secret", broker_params,
                        f"保存密钥 {name}")
                    if verdict != "approved":
                        holder["text"] = f"未保存：审批结果 {verdict}"
                    else:
                        reply = agentlib.broker_execute(
                            ticket_id, "write-secret", broker_params)
                        holder["text"] = (
                            f"密钥 {name} 已保存" if reply.get("ok")
                            else f"保存失败：{reply.get('error')}")
                except Exception as exc:  # noqa: BLE001
                    holder["text"] = f"保存失败：{exc}"
                finally:
                    done.set()

            _threading.Thread(target=_work, daemon=True).start()
            done.wait(timeout=660)
            text = holder.get("text", "保存超时")
            return {"ok": text.endswith("已保存") or "已保存" in text,
                    "message": text}
        if verb == "registry.list":
            if registrylib is None:
                raise ValueError("registrylib 不可用")
            data, skipped = registrylib.load_registry()
            return {"counts": {k: len(v) for k, v in data.items()
                               if isinstance(v, list)},
                    "skipped": skipped}
        if verb == "model.catalog":
            return self._model_catalog_result()
        if verb == "model.provider.save":
            if registrylib is None:
                raise ValueError("registrylib 不可用")
            entry = params.get("provider")
            if not isinstance(entry, dict):
                raise ValueError("model.provider.save 需要 provider 对象")
            builtin_ids = {p["id"] for p in self._catalog_providers()}
            if entry.get("id") in builtin_ids:
                raise ValueError(
                    "内置供应商不能作为自定义供应商保存；请用覆盖层编辑")
            data, _skipped = registrylib.load_registry()
            saved = registrylib.upsert_provider(data, entry)
            self._save_registry_and_notify(
                data, f"custom provider saved: {saved['id']}")
            return {"provider": saved}
        if verb == "model.provider.delete":
            if registrylib is None:
                raise ValueError("registrylib 不可用")
            pid = params.get("provider")
            builtin_ids = {p["id"] for p in self._catalog_providers()}
            if pid in builtin_ids:
                raise ValueError(
                    "内置供应商不能删除；可禁用或恢复默认（删除覆盖层）")
            data, _skipped = registrylib.load_registry()
            registrylib.remove_entry(data, "providers", pid)
            self._save_registry_and_notify(
                data, f"custom provider deleted: {pid}")
            return {"deleted": pid}
        if verb in ("model.provider.override", "model.provider.reset"):
            if registrylib is None:
                raise ValueError("registrylib 不可用")
            pid = params.get("provider")
            builtin_ids = {p["id"] for p in self._catalog_providers()}
            if pid not in builtin_ids:
                raise ValueError(f"不是内置供应商：{pid!r}")
            data, _skipped = registrylib.load_registry()
            cfg = dict(data.get("model_config")
                       or registrylib.default_model_config())
            overrides = dict(cfg.get("provider_overrides") or {})
            if verb == "model.provider.reset":
                overrides.pop(pid, None)
                summary = f"provider override reset: {pid}"
            else:
                overlay = params.get("override")
                overrides[pid] = registrylib.normalize_provider_override(
                    overlay)
                summary = f"provider override saved: {pid}"
            cfg["provider_overrides"] = overrides
            data["model_config"] = registrylib.normalize_model_config(cfg)
            self._save_registry_and_notify(data, summary)
            return {"provider": pid,
                    "override": overrides.get(pid)}
        if verb == "model.config.get":
            if registrylib is None or settingslib is None:
                raise ValueError("registrylib/settingslib 不可用")
            data, _skipped = registrylib.load_registry()
            return {"config": data.get("model_config"),
                    "settings": settingslib.load_settings()}
        if verb == "model.config.save":
            if registrylib is None:
                raise ValueError("registrylib 不可用")
            raw = params.get("config")
            # Validation happens BEFORE any write: a bad config
            # raises here and nothing is persisted.
            clean = registrylib.normalize_model_config(raw)
            data, _skipped = registrylib.load_registry()
            data["model_config"] = clean
            self._save_registry_and_notify(
                data, "model config saved via settings host")
            return {"config": clean}
        if verb == "model.health":
            if modellib is None:
                raise ValueError("modellib 不可用")
            return modellib.health_status()
        if verb == "model.test":
            if llmlib is None:
                raise ValueError("llmlib 不可用")
            return llmlib.test_connection(
                params.get("provider"), params.get("model"))
        if verb == "model.usage":
            if usagelib is None:
                raise ValueError("usagelib 不可用")
            return usagelib.aggregate_usage()
        raise ValueError(f"未实现的桥动词：{verb}")

    def _refresh_from_store(self):
        self.settings.begin_sync()
        try:
            if hasattr(self, "mode_combo"):
                current = self.settings.get_string("window-mode")
                self.mode_combo.set_active_id(
                    current if current in ("fullscreen", "windowed")
                    else "fullscreen")
            if hasattr(self, "fa_switch"):
                self.fa_switch.set_active(
                    self.settings.get_boolean("agent-full-access"))
            if hasattr(self, "dark_switch"):
                self.dark_switch.set_active(
                    self.settings.get_boolean("ui-dark"))
            if hasattr(self, "routing_combo"):
                current = self.settings.get_string("routing-mode")
                self.routing_combo.set_active_id(
                    current if current in ("auto", "manual") else "auto")
            refresh_ai = getattr(self, "_refresh_ai", None)
            if refresh_ai is not None:
                refresh_ai()
        finally:
            self.settings.end_sync()

    def labeled_row(self, label_text, widget):
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        row.set_border_width(6)
        label = Gtk.Label(label=label_text)
        label.set_halign(Gtk.Align.START)
        label.set_size_request(140, -1)
        row.pack_start(label, False, False, 0)
        row.pack_start(widget, True, True, 0)
        return row

    def build_general_panel(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        box.set_border_width(12)

        mode_combo = Gtk.ComboBoxText()
        mode_combo.append("fullscreen", "全屏（除任务栏外全屏）")
        mode_combo.append("windowed", "窗口模式（不自动最大化）")
        current = self.settings.get_string("window-mode")
        mode_combo.set_active_id(
            current if current in ("fullscreen", "windowed")
            else "fullscreen")
        mode_combo.connect(
            "changed",
            lambda combo: self.settings.set_string(
                "window-mode", combo.get_active_id() or "fullscreen"))
        self.mode_combo = mode_combo
        box.pack_start(
            self.labeled_row("应用窗口模式", mode_combo), False, False, 0)

        note = Gtk.Label(
            label="说明：全屏模式下从任务栏切换应用时窗口最大化，任务栏"
                  "通过底部保留区始终可见；窗口模式则只激活不最大化。")
        note.set_line_wrap(True)
        note.set_halign(Gtk.Align.START)
        box.pack_start(note, False, False, 0)

        # Phase 3 module 4: full-access toggle. The agent service reads
        # this key (agentlib.full_access_enabled); the GUI only writes
        # it — the service never writes its own permission.
        fa_switch = Gtk.Switch()
        fa_switch.set_active(self.settings.get_boolean("agent-full-access"))
        fa_switch.connect(
            "notify::active",
            lambda sw, _pspec: self.settings.set_boolean(
                "agent-full-access", sw.get_active()))
        self.fa_switch = fa_switch
        box.pack_start(
            self.labeled_row("Agent 完全访问（无限制）", fa_switch),
            False, False, 0)
        fa_note = Gtk.Label(
            label="警告：开启后 agent 的所有工具调用（含删文件、工作区外"
                  "操作、装软件）不再弹窗等待人工批准，自动通过；但每次"
                  "调用仍会创建票据并记入事件日志。默认关闭。")
        fa_note.set_line_wrap(True)
        fa_note.set_halign(Gtk.Align.START)
        box.pack_start(fa_note, False, False, 0)

        # Phase 5 module 5: dark UI variant (docs/UI-RULES.md).
        # theme.py reads this key at app startup; toggling takes
        # effect the next time each app starts.
        dark_switch = Gtk.Switch()
        dark_switch.set_active(self.settings.get_boolean("ui-dark"))
        dark_switch.connect(
            "notify::active",
            lambda sw, _pspec: self.settings.set_boolean(
                "ui-dark", sw.get_active()))
        self.dark_switch = dark_switch
        box.pack_start(
            self.labeled_row("深色界面", dark_switch), False, False, 0)
        dark_note = Gtk.Label(
            label="说明：深色调色板按 UI 规范的暗色层级（#0b0b0a 起）"
                  "呈现，字重整体下调一档防发胖；各应用下次启动时生效。")
        dark_note.set_line_wrap(True)
        dark_note.set_halign(Gtk.Align.START)
        box.pack_start(dark_note, False, False, 0)
        return box

    def load_catalog(self):
        """Read the routing catalog JSON; None when the engine is absent.

        The catalog is generated at image build time by the routing
        engine hook (module 4) from the vendored provider registry.
        A missing or unreadable catalog is NOT an error: the panel
        falls back to free-text entries (module 3 behavior).
        """
        try:
            with open(CATALOG_PATH, "r", encoding="utf-8") as handle:
                data = json.load(handle)
            providers = data.get("providers")
            if not isinstance(providers, list):
                return None
            return providers
        except (OSError, ValueError):
            return None

    def build_ai_panel(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        box.set_border_width(12)

        catalog = self.load_catalog()
        if catalog:
            providers_by_id = {}
            for entry in catalog:
                if isinstance(entry, dict) and isinstance(
                        entry.get("id"), str):
                    providers_by_id[entry["id"]] = entry
            provider_combo = Gtk.ComboBoxText()
            for pid in providers_by_id:
                provider_combo.append(pid, pid)
            current_provider = self.settings.get_string("ai-provider")
            if current_provider and current_provider not in providers_by_id:
                provider_combo.prepend(
                    current_provider,
                    current_provider + "（未在目录中）")
            if current_provider:
                provider_combo.set_active_id(current_provider)

            model_combo = Gtk.ComboBoxText()

            def refresh_models(pid):
                model_combo.remove_all()
                entry = providers_by_id.get(pid)
                models = entry.get("models") if isinstance(entry, dict) \
                    else None
                ids = [m["id"] for m in (models or [])
                       if isinstance(m, dict)
                       and isinstance(m.get("id"), str)]
                for mid in ids:
                    model_combo.append(mid, mid)
                current_model = self.settings.get_string("ai-model")
                if current_model and current_model not in ids:
                    model_combo.prepend(
                        current_model,
                        current_model + "（未在目录中）")
                if current_model:
                    model_combo.set_active_id(current_model)

            def on_provider_changed(combo):
                pid = combo.get_active_id()
                if pid:
                    self.settings.set_string("ai-provider", pid)
                    refresh_models(pid)

            provider_combo.connect("changed", on_provider_changed)
            model_combo.connect(
                "changed",
                lambda combo: self.settings.set_string(
                    "ai-model", combo.get_active_id() or ""))
            refresh_models(current_provider)
            box.pack_start(
                self.labeled_row("AI 供应商", provider_combo),
                False, False, 0)
            box.pack_start(
                self.labeled_row("AI 模型", model_combo),
                False, False, 0)

            def _refresh_ai():
                # Focus refresh (P5-M7): pull the store's provider
                # into the combos (adapter suspended by the caller,
                # so the changed signals below write nothing back).
                pid = self.settings.get_string("ai-provider")
                if pid and pid not in providers_by_id and \
                        provider_combo.get_active_id() != pid:
                    provider_combo.prepend(
                        pid, pid + "（未在目录中）")
                if pid:
                    provider_combo.set_active_id(pid)
                refresh_models(pid)

            self._refresh_ai = _refresh_ai
        else:
            provider = Gtk.Entry()
            provider.set_text(self.settings.get_string("ai-provider"))
            provider.connect(
                "changed",
                lambda entry: self.settings.set_string(
                    "ai-provider", entry.get_text()))
            box.pack_start(
                self.labeled_row("AI 供应商", provider), False, False, 0)

            model = Gtk.Entry()
            model.set_text(self.settings.get_string("ai-model"))
            model.connect(
                "changed",
                lambda entry: self.settings.set_string(
                    "ai-model", entry.get_text()))
            box.pack_start(
                self.labeled_row("AI 模型", model), False, False, 0)

            def _refresh_ai():
                provider.set_text(self.settings.get_string("ai-provider"))
                model.set_text(self.settings.get_string("ai-model"))

            self._refresh_ai = _refresh_ai

        routing = Gtk.ComboBoxText()
        routing.append("auto", "自动（路由引擎选择）")
        routing.append("manual", "手动（固定供应商与模型）")
        current = self.settings.get_string("routing-mode")
        routing.set_active_id(
            current if current in ("auto", "manual") else "auto")
        routing.connect(
            "changed",
            lambda combo: self.settings.set_string(
                "routing-mode", combo.get_active_id() or "auto"))
        self.routing_combo = routing
        box.pack_start(
            self.labeled_row("路由模式", routing), False, False, 0)

        note = Gtk.Label(
            label="说明：供应商与模型下拉来自路由引擎目录 "
                  "(/usr/share/dclawos/engine/catalog.json，模块 4 编译生成)；"
                  "目录缺失时回退自由文本输入。API 密钥在「密钥」页保存，"
                  "名称须为 llm-<供应商 id>（如 llm-openai）；agent 服务"
                  "只读该命名的密钥调用模型，密钥永不回显。")
        note.set_line_wrap(True)
        note.set_halign(Gtk.Align.START)
        box.pack_start(note, False, False, 0)
        return box

    def build_skills_panel(self):
        """Skills + MCP unified management (module 9, Q3: GUI, no TUI)."""
        if registrylib is None:
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            box.set_border_width(12)
            label = Gtk.Label(label="注册表库不可用（registrylib 缺失），"
                                   "无法管理 Skills 与 MCP。")
            label.set_line_wrap(True)
            label.set_halign(Gtk.Align.START)
            box.pack_start(label, False, False, 0)
            return box

        scrolled = Gtk.ScrolledWindow()
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        box.set_border_width(12)
        scrolled.add(box)

        note = Gtk.Label(
            label="说明：Skills、MCP 与连接器在此统一管理（Q3，不走 TUI）。"
                  "MCP/连接器调用的审批走票据 broker（agent 服务已接入）。"
                  "MCP 环境变量不在此页编辑（常为密钥）：需要密钥时在"
                  "「密钥」页保存，注册表 env 写 secret:<名称> 引用。")
        note.set_line_wrap(True)
        note.set_halign(Gtk.Align.START)
        box.pack_start(note, False, False, 0)

        self.registry_status = Gtk.Label(label="")
        self.registry_status.set_halign(Gtk.Align.START)
        box.pack_start(self.registry_status, False, False, 0)

        # Phase 5 module 5 (iron rule 7): each registry group is a
        # collapsible revealer section — the layout engine animates
        # the height; no code measures pixels.
        self.skills_store, skills_scroll = self._registry_tree(
            ("名称", "ID", "路径", "启用", "许可证"), (0, 2))
        box.pack_start(self._registry_section(
            "Skills", skills_scroll,
            (("添加 Skill", self.on_add_skill),
             ("删除 Skill", self.on_remove_skill),
             ("切换启用", self.on_toggle_skill))), True, True, 0)
        self.skills_scroll = skills_scroll

        self.servers_store, servers_scroll = self._registry_tree(
            ("名称", "ID", "命令与参数", "启用", "许可证"), (0, 2))
        box.pack_start(self._registry_section(
            "MCP 服务器", servers_scroll,
            (("添加 MCP 服务器", self.on_add_server),
             ("删除 MCP 服务器", self.on_remove_server),
             ("切换启用", self.on_toggle_server))), True, True, 0)
        self.servers_scroll = servers_scroll

        self.connectors_store, connectors_scroll = self._registry_tree(
            ("名称", "ID", "命令与参数", "启用", "许可证"), (0, 2))
        box.pack_start(self._registry_section(
            "连接器", connectors_scroll,
            (("添加连接器", self.on_add_connector),
             ("删除连接器", self.on_remove_connector),
             ("切换启用", self.on_toggle_connector))), True, True, 0)
        self.connectors_scroll = connectors_scroll

        self.refresh_registry()
        return scrolled

    def _registry_section(self, title, scroll, buttons):
        """One collapsible registry group (rule 7). Falls back to a
        plain labelled block when theme.make_section is unavailable."""
        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL,
                          spacing=6)
        content.pack_start(scroll, True, True, 0)
        content.pack_start(self._registry_buttons(buttons),
                           False, False, 0)
        try:
            import theme
            return theme.make_section(title, content)
        except Exception:
            outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL,
                            spacing=6)
            label = Gtk.Label(label=title)
            label.set_halign(Gtk.Align.START)
            outer.pack_start(label, False, False, 0)
            outer.pack_start(content, True, True, 0)
            return outer

    def _registry_tree(self, titles, expand_indices):
        store = Gtk.ListStore(str, str, str, str, str)
        tree = Gtk.TreeView(model=store)
        for index, title in enumerate(titles):
            column = Gtk.TreeViewColumn(
                title, Gtk.CellRendererText(), text=index)
            column.set_resizable(True)
            if index in expand_indices:
                column.set_expand(True)
            tree.append_column(column)
        scrolled = Gtk.ScrolledWindow()
        scrolled.set_min_content_height(150)
        scrolled.add(tree)
        return store, scrolled

    def _registry_buttons(self, buttons):
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        for label, handler in buttons:
            button = Gtk.Button(label=label)
            button.connect("clicked", handler)
            row.pack_start(button, False, False, 0)
        return row

    def _selected_id(self, tree):
        selection = tree.get_selection()
        model, tree_iter = selection.get_selected()
        if tree_iter is None:
            return None
        return model[tree_iter][1]

    def refresh_registry(self):
        try:
            data, skipped = registrylib.load_registry()
        except ValueError as exc:
            self.registry_status.set_text(f"注册表读取失败：{exc}")
            self.skills_store.clear()
            self.servers_store.clear()
            self.connectors_store.clear()
            return
        self.skills_store.clear()
        for entry in data["skills"]:
            self.skills_store.append((
                entry.get("name", ""), entry.get("id", ""),
                entry.get("path", ""),
                "是" if entry.get("enabled") else "否",
                entry.get("license", "")))
        self.servers_store.clear()
        for entry in data["mcp_servers"]:
            command = entry.get("command", "")
            args = " ".join(entry.get("args", []))
            shown = f"{command} {args}".strip()
            self.servers_store.append((
                entry.get("name", ""), entry.get("id", ""), shown,
                "是" if entry.get("enabled") else "否",
                entry.get("license", "")))
        self.connectors_store.clear()
        for entry in data["connectors"]:
            command = entry.get("command", "")
            args = " ".join(entry.get("args", []))
            shown = f"{command} {args}".strip()
            self.connectors_store.append((
                entry.get("name", ""), entry.get("id", ""), shown,
                "是" if entry.get("enabled") else "否",
                entry.get("license", "")))
        status = (f"Skills {len(data['skills'])} 个，"
                  f"MCP 服务器 {len(data['mcp_servers'])} 个，"
                  f"连接器 {len(data['connectors'])} 个")
        if skipped:
            status += f"（{skipped} 条无效记录已跳过）"
        self.registry_status.set_text(status)

    def _entry_row(self, area, label_text):
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        row.pack_start(Gtk.Label(label=label_text), False, False, 0)
        entry = Gtk.Entry()
        row.pack_start(entry, True, True, 0)
        area.pack_start(row, False, False, 0)
        return entry

    def _confirm(self, text):
        dialog = Gtk.MessageDialog(
            transient_for=self,
            message_type=Gtk.MessageType.QUESTION,
            buttons=Gtk.ButtonsType.OK_CANCEL,
            text=text)
        response = dialog.run()
        dialog.destroy()
        return response == Gtk.ResponseType.OK

    def _error(self, text):
        dialog = Gtk.MessageDialog(
            transient_for=self,
            message_type=Gtk.MessageType.ERROR,
            buttons=Gtk.ButtonsType.OK,
            text=text)
        dialog.run()
        dialog.destroy()

    def _add_dialog(self, kind):
        """Add-entry dialog loop. Returns True if something was added."""
        titles = {"skill": "添加 Skill", "server": "添加 MCP 服务器",
                  "connector": "添加连接器"}
        title = titles.get(kind, "添加")
        dialog = Gtk.Dialog(title=title, transient_for=self,
                            flags=Gtk.DialogFlags.MODAL)
        dialog.add_button("取消", Gtk.ResponseType.CANCEL)
        dialog.add_button("添加", Gtk.ResponseType.OK)
        area = dialog.get_content_area()
        area.set_border_width(8)
        name = self._entry_row(area, "名称：")
        entry_id = self._entry_row(area, "ID（小写字母/数字/_/-）：")
        if kind == "skill":
            path_or_cmd = self._entry_row(area, "路径：")
            args_entry = None
        else:
            path_or_cmd = self._entry_row(area, "命令：")
            args_entry = self._entry_row(area, "参数（空格分隔）：")
        description = self._entry_row(area, "描述：")
        license_entry = self._entry_row(area, "许可证：")
        dialog.show_all()
        added = False
        while dialog.run() == Gtk.ResponseType.OK:
            entry = {
                "id": entry_id.get_text().strip(),
                "name": name.get_text().strip(),
                "description": description.get_text().strip(),
                "license": license_entry.get_text().strip(),
            }
            if kind == "skill":
                entry["path"] = path_or_cmd.get_text().strip()
            else:
                entry["command"] = path_or_cmd.get_text().strip()
                entry["args"] = args_entry.get_text().split()
            if not entry["license"]:
                if not self._confirm(
                        "未填写许可证：该包未声明许可证，仍要添加吗？"):
                    continue
            try:
                data, _skipped = registrylib.load_registry()
                if kind == "skill":
                    registrylib.add_skill(data, entry)
                elif kind == "server":
                    registrylib.add_server(data, entry)
                else:
                    registrylib.add_connector(data, entry)
                registrylib.save_registry(data)
            except ValueError as exc:
                self._error(f"添加失败：{exc}")
                continue
            added = True
            break
        dialog.destroy()
        if added:
            self.refresh_registry()
        return added

    def on_add_skill(self, _button):
        self._add_dialog("skill")

    def on_add_server(self, _button):
        self._add_dialog("server")

    def on_add_connector(self, _button):
        self._add_dialog("connector")

    def build_secrets_panel(self):
        """Secret store page (Phase 3 module 2).

        Writes go through the privileged broker's write-secret op,
        gated by a ticket (approval popup or full-access auto-approval)
        — the same gate the agent service uses. Values are never shown
        back, never logged, and never stored in the registry: the
        registry env references them as secret:<name>.

        Why files, not libsecret: the agent service runs as the
        dclaw-agent system user, which has no login session and no
        unlocked keyring; a root broker cannot unlock the human user's
        keyring either. Broker-written 0600 files owned by dclaw-agent
        are the equivalent store for a service user.
        """
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        box.set_border_width(12)
        if agentlib is None:
            label = Gtk.Label(label="agentlib 不可用，无法保存密钥。")
            label.set_line_wrap(True)
            label.set_halign(Gtk.Align.START)
            box.pack_start(label, False, False, 0)
            return box
        note = Gtk.Label(
            label="说明：密钥只写不读，保存后无法查看原文，只能被 agent "
                  "服务通过 secret:<名称> 引用。保存需要审批（弹出审批"
                  "窗口确认，或开启完全访问后自动通过）。")
        note.set_line_wrap(True)
        note.set_halign(Gtk.Align.START)
        box.pack_start(note, False, False, 0)
        self.secret_name = Gtk.Entry()
        box.pack_start(self.labeled_row("名称（小写字母/数字/_/-）：",
                                        self.secret_name), False, False, 0)
        self.secret_value = Gtk.Entry()
        self.secret_value.set_visibility(False)
        box.pack_start(self.labeled_row("密钥值：", self.secret_value),
                       False, False, 0)
        self.secret_status = Gtk.Label(label="")
        self.secret_status.set_halign(Gtk.Align.START)
        self.secret_status.set_line_wrap(True)
        box.pack_start(self.secret_status, False, False, 0)
        save_btn = Gtk.Button(label="保存密钥（需审批）")
        save_btn.connect("clicked", self.on_save_secret)
        box.pack_start(save_btn, False, False, 0)
        return box

    def _store_secret(self, name, value, report):
        """Broker write-secret flow shared by the secrets page and
        the channels page (Phase 5). report(text) is called on the
        GTK thread with the outcome. The broker validates the
        ticket by params hash, so approval params and execution
        params must be the identical dict (same as dclawos-secret);
        the value lives only in memory, the ticket stores a hash."""

        def work():
            params = {"name": name, "value": value}
            try:
                verdict, ticket_id = agentlib.request_approval(
                    "write-secret", params, f"保存密钥 {name}")
                if verdict != "approved":
                    GLib.idle_add(report, f"未保存：审批结果 {verdict}。")
                    return
                reply = agentlib.broker_execute(
                    ticket_id, "write-secret", params)
                if reply.get("ok"):
                    GLib.idle_add(report, f"密钥 {name} 已保存。")
                else:
                    GLib.idle_add(report,
                                  f"保存失败：{reply.get('error')}")
            except Exception as exc:  # noqa: BLE001 - surface to user
                GLib.idle_add(report, f"保存失败：{exc}")

        threading.Thread(target=work, daemon=True).start()

    def on_save_secret(self, _button):
        name = self.secret_name.get_text().strip()
        value = self.secret_value.get_text()
        if not name or not value:
            self.secret_status.set_text("名称与密钥值都不能为空。")
            return
        self.secret_status.set_text("等待审批……")
        self.secret_value.set_text("")

        def report(text):
            self.secret_status.set_text(text)
            if "已保存" in text:
                # Iron rule 10: success feedback extinguishes
                # itself after 2.5 s (if nothing newer replaced it).
                def _clear():
                    if self.secret_status.get_text() == text:
                        self.secret_status.set_text("")
                    return False
                GLib.timeout_add(2500, _clear)

        self._store_secret(name, value, report)

    # -------------------------------------------------- channels

    CHANNEL_KINDS = ("telegram", "discord", "slack", "matrix")

    def build_channels_panel(self):
        """Third-party messaging channels (Phase 5, WS1).

        A channel entry lives in the unified registry (kind picks a
        built-in adapter; no arbitrary commands). The bot token is
        NOT stored in the registry: it goes through the broker
        write-secret flow as secret channel-<id>, write-only, the
        same store as provider keys. The allowlist holds the owner
        account ids allowed to talk to the agent — anyone else is
        ignored by the daemon (no task, no reply). Changes here are
        picked up by the agent service on its next poll cycle; the
        agent's own channel_manage tool writes the same registry.
        """
        scrolled = Gtk.ScrolledWindow()
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        box.set_border_width(12)
        scrolled.add(box)
        if registrylib is None or agentlib is None:
            label = Gtk.Label(label="注册表或 agentlib 不可用，"
                                    "无法管理渠道。")
            label.set_line_wrap(True)
            label.set_halign(Gtk.Align.START)
            box.pack_start(label, False, False, 0)
            return scrolled
        note = Gtk.Label(
            label="说明：渠道让 agent 通过第三方消息服务（Telegram / "
                  "Discord / Slack / Matrix 机器人）收发消息。令牌只写"
                  "不读（保存为密钥 channel-<渠道ID>，需审批）。白名单"
                  "填你自己的账号 ID（逗号分隔）：只有白名单内的人发来"
                  "的消息会变成 agent 任务，其余一律忽略；白名单为空 "
                  "= 谁都不能用。在机器人那里先发一句话，agent 的回复"
                  "会回到同一会话。类型要点：Discord 需在附加选项填 "
                  "{\"channel_id\": \"目标频道ID\"}；Slack 还需第二个"
                  "应用令牌，保存为密钥 channel-<渠道ID>-app（在密钥页"
                  "添加）；Matrix 需在附加选项填 {\"homeserver\": "
                  "\"https://你的服务器\"}，且只支持未加密房间。")
        note.set_line_wrap(True)
        note.set_halign(Gtk.Align.START)
        try:
            import theme
            theme.apply_prose(note)
        except Exception:
            pass
        box.pack_start(note, False, False, 0)
        self.channels_status = Gtk.Label(label="")
        self.channels_status.set_halign(Gtk.Align.START)
        box.pack_start(self.channels_status, False, False, 0)
        self.channels_store, channels_scroll = self._registry_tree(
            ("名称", "ID", "类型", "启用", "白名单"), (0, 4))
        box.pack_start(channels_scroll, True, True, 0)
        box.pack_start(self._registry_buttons(
            (("添加渠道", self.on_add_channel),
             ("删除渠道", self.on_remove_channel),
             ("切换启用", self.on_toggle_channel),
             ("更新令牌/白名单", self.on_edit_channel))),
            False, False, 0)
        self.channels_scroll = channels_scroll
        self.refresh_channels()
        return scrolled

    def refresh_channels(self):
        if not hasattr(self, "channels_store"):
            return
        try:
            data, _skipped = registrylib.load_registry()
        except ValueError as exc:
            self.channels_status.set_text(f"注册表读取失败：{exc}")
            self.channels_store.clear()
            return
        self.channels_store.clear()
        for entry in data.get("channels", []):
            self.channels_store.append((
                entry.get("name", ""), entry.get("id", ""),
                entry.get("kind", ""),
                "是" if entry.get("enabled") else "否",
                ",".join(entry.get("allowlist", []))))
        self.channels_status.set_text(
            f"渠道 {len(data.get('channels', []))} 个")

    def _channel_fields_dialog(self, title, entry=None):
        """Add/edit channel dialog. Returns (values, token) or
        (None, "") on cancel. Token is write-only: always starts
        empty; empty means "leave the stored token unchanged"."""
        dialog = Gtk.Dialog(title=title, transient_for=self,
                            flags=Gtk.DialogFlags.MODAL)
        dialog.add_button("取消", Gtk.ResponseType.CANCEL)
        dialog.add_button("保存", Gtk.ResponseType.OK)
        area = dialog.get_content_area()
        area.set_border_width(8)
        name = self._entry_row(area, "名称：")
        entry_id = self._entry_row(area, "ID（小写字母/数字/_/-）：")
        kind_combo = Gtk.ComboBoxText()
        for kind in self.CHANNEL_KINDS:
            kind_combo.append(kind, kind)
        kind_combo.set_active(0)
        kind_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL,
                           spacing=6)
        kind_row.pack_start(Gtk.Label(label="类型："), False, False, 0)
        kind_row.pack_start(kind_combo, True, True, 0)
        area.pack_start(kind_row, False, False, 0)
        allow = self._entry_row(area, "白名单（账号 ID，逗号分隔）：")
        options = self._entry_row(area, "附加选项（JSON，可留空）：")
        token = self._entry_row(area, "令牌（只写，可留空）：")
        token.set_visibility(False)
        if entry is not None:
            name.set_text(entry.get("name", ""))
            entry_id.set_text(entry.get("id", ""))
            entry_id.set_sensitive(False)
            if entry.get("kind") in self.CHANNEL_KINDS:
                kind_combo.set_active_id(entry["kind"])
            allow.set_text(",".join(entry.get("allowlist", [])))
            if entry.get("options"):
                import json as _json
                options.set_text(_json.dumps(
                    entry["options"], ensure_ascii=False))
        dialog.show_all()
        values = None
        token_text = ""
        if dialog.run() == Gtk.ResponseType.OK:
            import json as _json
            options_text = options.get_text().strip()
            options_value = {}
            if options_text:
                try:
                    options_value = _json.loads(options_text)
                    if not isinstance(options_value, dict):
                        raise ValueError("附加选项必须是 JSON 对象")
                except ValueError as exc:
                    dialog.destroy()
                    return {"error": f"附加选项 JSON 无效：{exc}"}, ""
            values = {
                "id": entry_id.get_text().strip(),
                "name": name.get_text().strip(),
                "kind": kind_combo.get_active_id() or "telegram",
                "allowlist": [part.strip() for part in
                              allow.get_text().split(",")
                              if part.strip()],
                "options": options_value,
            }
            token_text = token.get_text().strip()
        dialog.destroy()
        return values, token_text

    def on_add_channel(self, _button):
        values, token = self._channel_fields_dialog("添加渠道")
        if values is None:
            return
        if values.get("error"):
            self._error(values["error"])
            return
        values["secret"] = f"channel-{values['id']}"
        try:
            data, _skipped = registrylib.load_registry()
            registrylib.add_channel(data, values)
            registrylib.save_registry(data)
        except ValueError as exc:
            self._error(f"添加失败：{exc}")
            return
        self.refresh_channels()
        if token:
            self.channels_status.set_text("渠道已添加，正在保存令牌……")
            self._store_secret(values["secret"], token,
                               self.channels_status.set_text)

    def on_remove_channel(self, _button):
        self._remove_selected("channel",
                              self.channels_scroll.get_child())
        self.refresh_channels()

    def on_toggle_channel(self, _button):
        self._toggle_selected("channel",
                              self.channels_scroll.get_child())
        self.refresh_channels()

    def on_edit_channel(self, _button):
        tree = self.channels_scroll.get_child()
        entry_id = self._selected_id(tree)
        if entry_id is None:
            self._error("请先选择一行")
            return
        try:
            data, _skipped = registrylib.load_registry()
        except ValueError as exc:
            self._error(f"读取失败：{exc}")
            return
        current = None
        for entry in data.get("channels", []):
            if entry.get("id") == entry_id:
                current = entry
                break
        if current is None:
            self._error(f"找不到渠道 {entry_id!r}")
            return
        values, token = self._channel_fields_dialog(
            "更新令牌/白名单", entry=current)
        if values is None:
            return
        if values.get("error"):
            self._error(values["error"])
            return
        current["name"] = values["name"] or current.get("name", "")
        current["allowlist"] = values["allowlist"]
        current["kind"] = values["kind"]
        current["options"] = values["options"]
        try:
            registrylib.save_registry(data)
        except (OSError, ValueError) as exc:
            self._error(f"保存失败：{exc}")
            return
        self.refresh_channels()
        if token:
            self.channels_status.set_text("正在保存令牌……")
            self._store_secret(
                current.get("secret") or f"channel-{entry_id}",
                token, self.channels_status.set_text)

    def _remove_selected(self, kind, tree):
        entry_id = self._selected_id(tree)
        if entry_id is None:
            self._error("请先选择一行")
            return
        labels = {"skill": "Skill", "server": "MCP 服务器",
                  "connector": "连接器", "channel": "渠道"}
        keys = {"skill": "skills", "server": "mcp_servers",
                "connector": "connectors", "channel": "channels"}
        label = labels.get(kind, kind)
        if not self._confirm(f"确定删除{label} {entry_id} 吗？"):
            return
        try:
            data, _skipped = registrylib.load_registry()
            registrylib.remove_entry(data, keys[kind], entry_id)
            registrylib.save_registry(data)
        except ValueError as exc:
            self._error(f"删除失败：{exc}")
            return
        self.refresh_registry()

    def on_remove_skill(self, _button):
        self._remove_selected("skill", self.skills_scroll.get_child())

    def on_remove_server(self, _button):
        self._remove_selected("server", self.servers_scroll.get_child())

    def on_remove_connector(self, _button):
        self._remove_selected("connector", self.connectors_scroll.get_child())

    def _toggle_selected(self, kind, tree):
        entry_id = self._selected_id(tree)
        if entry_id is None:
            self._error("请先选择一行")
            return
        try:
            data, _skipped = registrylib.load_registry()
            key = {"skill": "skills", "server": "mcp_servers",
                   "connector": "connectors",
                   "channel": "channels"}[kind]
            current = None
            for entry in data[key]:
                if entry.get("id") == entry_id:
                    current = entry
                    break
            if current is None:
                raise ValueError(f"找不到 {entry_id!r}")
            registrylib.set_enabled(
                data, key, entry_id, not current.get("enabled", True))
            registrylib.save_registry(data)
        except ValueError as exc:
            self._error(f"切换失败：{exc}")
            return
        self.refresh_registry()

    def on_toggle_skill(self, _button):
        self._toggle_selected("skill", self.skills_scroll.get_child())

    def on_toggle_server(self, _button):
        self._toggle_selected("server", self.servers_scroll.get_child())

    def on_toggle_connector(self, _button):
        self._toggle_selected("connector",
                              self.connectors_scroll.get_child())


def main():
    if len(sys.argv) > 1 and sys.argv[1] in ("-h", "--help"):
        print("usage: dclawos-settings (writes the shared settings "
              "file via settingslib, P5-M7)")
        return 0
    if settingslib is None:
        print("dclawos-settings: settingslib unavailable; the shared "
              "settings store is missing, which means a broken image.",
              file=sys.stderr)
        return 1
    migrate_gsettings_once()
    settings = SharedSettings()
    log("dclawos-settings started (P5-M7: shared settings file GUI)")
    win = SettingsApp(settings)
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()
    return 0


if __name__ == "__main__":
    sys.exit(main())
