#!/usr/bin/env python3
"""DclawOS settings app (Phase 2 module 3): self-built GUI settings.

Panels: General (window mode), AI & Model (provider / model / routing),
Skills & MCP (placeholder until module 9 wires unified management).
Every control writes DIRECTLY to the DclawOS GSettings schema — no HTTP
API, no intermediate service (the user-confirmed "native direct"
requirement, cards §3). The schema lives in
org.dclawos.settings (compiled at image build time by hook 1002).

Reuse notes (evaluation cards §3, step 0 retrieval):
- Panel organization (one page per panel, sidebar navigation) follows the
  gnome-control-center CcPanel organization PATTERN (panels/ directory);
  no gnome-control-center code is copied and the full app is not used.
- Direct-write calls follow the gnome-control-center pattern
  (panels/power/cc-power-panel.c:372 g_settings_set_boolean, :630/:637
  g_settings_set_uint): the calls themselves are plain Gio.Settings
  API, retargeted from GNOME schemas to the DclawOS own schema.
// reuse-check: gnome-control-center panels/* NOT copied, reason: only
  the organization pattern is reusable; every panel's content is new
  (DclawOS schema keys do not exist in GNOME).
// reuse-check: cc-power-panel.c g_settings_set_* adopted as call
  pattern only, reason: the pattern IS "GUI writes GSettings directly",
  which is exactly the user requirement; the write target changed.
"""
import json
import os
import sys

import gi

gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gio  # noqa: E402

SCHEMA_ID = "org.dclawos.settings"
REGISTRY_DIR = "/var/lib/dclawos"
CATALOG_PATH = "/usr/share/dclawos/engine/catalog.json"


def log(msg):
    print(f"dclawos-settings: {msg}", flush=True)


class SettingsApp(Gtk.Window):
    def __init__(self, settings):
        super().__init__(title="dclawos-settings")
        self.settings = settings
        self.set_default_size(900, 600)

        paned = Gtk.Paned(orientation=Gtk.Orientation.HORIZONTAL)
        self.add(paned)

        stack = Gtk.Stack()
        stack.set_transition_type(Gtk.StackTransitionType.SLIDE_LEFT_RIGHT)
        sidebar = Gtk.StackSidebar()
        sidebar.set_stack(stack)
        paned.pack1(sidebar, False, False)
        paned.pack2(stack, True, False)

        stack.add_titled(self.build_general_panel(), "general", "通用")
        stack.add_titled(self.build_ai_panel(), "ai", "AI 与模型")
        stack.add_titled(self.build_skills_panel(), "skills", "Skills 与 MCP")

    def labeled_row(self, label_text, widget):
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        row.set_border_width(6)
        label = Gtk.Label(label=label_text)
        label.set_halign(Gtk.Align.START)
        label.set_size_request(140, -1)
        row.pack_start(label, False, False, 0)
        row.pack_start(widget, True, True, 0)
        return row

    def build_general_panel(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        box.set_border_width(12)

        mode_combo = Gtk.ComboBoxText()
        mode_combo.append("fullscreen", "全屏（除任务栏外全屏）")
        mode_combo.append("windowed", "窗口模式（不自动最大化）")
        current = self.settings.get_string("window-mode")
        mode_combo.set_active_id(
            current if current in ("fullscreen", "windowed")
            else "fullscreen")
        mode_combo.connect(
            "changed",
            lambda combo: self.settings.set_string(
                "window-mode", combo.get_active_id() or "fullscreen"))
        box.pack_start(
            self.labeled_row("应用窗口模式", mode_combo), False, False, 0)

        note = Gtk.Label(
            label="说明：全屏模式下从任务栏切换应用时窗口最大化，任务栏"
                  "通过底部保留区始终可见；窗口模式则只激活不最大化。")
        note.set_line_wrap(True)
        note.set_halign(Gtk.Align.START)
        box.pack_start(note, False, False, 0)
        return box

    def load_catalog(self):
        """Read the routing catalog JSON; None when the engine is absent.

        The catalog is generated at image build time by the routing
        engine hook (module 4) from the vendored provider registry.
        A missing or unreadable catalog is NOT an error: the panel
        falls back to free-text entries (module 3 behavior).
        """
        try:
            with open(CATALOG_PATH, "r", encoding="utf-8") as handle:
                data = json.load(handle)
            providers = data.get("providers")
            if not isinstance(providers, list):
                return None
            return providers
        except (OSError, ValueError):
            return None

    def build_ai_panel(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        box.set_border_width(12)

        catalog = self.load_catalog()
        if catalog:
            providers_by_id = {}
            for entry in catalog:
                if isinstance(entry, dict) and isinstance(
                        entry.get("id"), str):
                    providers_by_id[entry["id"]] = entry
            provider_combo = Gtk.ComboBoxText()
            for pid in providers_by_id:
                provider_combo.append(pid, pid)
            current_provider = self.settings.get_string("ai-provider")
            if current_provider and current_provider not in providers_by_id:
                provider_combo.prepend(
                    current_provider,
                    current_provider + "（未在目录中）")
            if current_provider:
                provider_combo.set_active_id(current_provider)

            model_combo = Gtk.ComboBoxText()

            def refresh_models(pid):
                model_combo.remove_all()
                entry = providers_by_id.get(pid)
                models = entry.get("models") if isinstance(entry, dict) \
                    else None
                ids = [m["id"] for m in (models or [])
                       if isinstance(m, dict)
                       and isinstance(m.get("id"), str)]
                for mid in ids:
                    model_combo.append(mid, mid)
                current_model = self.settings.get_string("ai-model")
                if current_model and current_model not in ids:
                    model_combo.prepend(
                        current_model,
                        current_model + "（未在目录中）")
                if current_model:
                    model_combo.set_active_id(current_model)

            def on_provider_changed(combo):
                pid = combo.get_active_id()
                if pid:
                    self.settings.set_string("ai-provider", pid)
                    refresh_models(pid)

            provider_combo.connect("changed", on_provider_changed)
            model_combo.connect(
                "changed",
                lambda combo: self.settings.set_string(
                    "ai-model", combo.get_active_id() or ""))
            refresh_models(current_provider)
            box.pack_start(
                self.labeled_row("AI 供应商", provider_combo),
                False, False, 0)
            box.pack_start(
                self.labeled_row("AI 模型", model_combo),
                False, False, 0)
        else:
            provider = Gtk.Entry()
            provider.set_text(self.settings.get_string("ai-provider"))
            provider.connect(
                "changed",
                lambda entry: self.settings.set_string(
                    "ai-provider", entry.get_text()))
            box.pack_start(
                self.labeled_row("AI 供应商", provider), False, False, 0)

            model = Gtk.Entry()
            model.set_text(self.settings.get_string("ai-model"))
            model.connect(
                "changed",
                lambda entry: self.settings.set_string(
                    "ai-model", entry.get_text()))
            box.pack_start(
                self.labeled_row("AI 模型", model), False, False, 0)

        routing = Gtk.ComboBoxText()
        routing.append("auto", "自动（路由引擎选择）")
        routing.append("manual", "手动（固定供应商与模型）")
        current = self.settings.get_string("routing-mode")
        routing.set_active_id(
            current if current in ("auto", "manual") else "auto")
        routing.connect(
            "changed",
            lambda combo: self.settings.set_string(
                "routing-mode", combo.get_active_id() or "auto"))
        box.pack_start(
            self.labeled_row("路由模式", routing), False, False, 0)

        note = Gtk.Label(
            label="说明：供应商与模型下拉来自路由引擎目录 "
                  "(/usr/share/dclawos/engine/catalog.json，模块 4 编译生成)；"
                  "目录缺失时回退自由文本输入。")
        note.set_line_wrap(True)
        note.set_halign(Gtk.Align.START)
        box.pack_start(note, False, False, 0)
        return box

    def build_skills_panel(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        box.set_border_width(12)
        try:
            entries = sorted(os.listdir(REGISTRY_DIR))
        except OSError:
            entries = []
        registry = [name for name in entries
                    if name.endswith(".json")]
        if registry:
            text = ("已发现本地注册表文件（统一管理在模块 9 接通后，"
                    "此处可启用 / 禁用 / 配置）：\n" + "\n".join(registry))
        else:
            text = ("Skills 与 MCP 的统一管理在模块 9 接通：届时 claw 的 "
                    "skill、mcp 等各项管理全部集成进本设置软件，不走 TUI。\n"
                    "当前本页仅作占位，不读写任何注册表。")
        label = Gtk.Label(label=text)
        label.set_line_wrap(True)
        label.set_halign(Gtk.Align.START)
        box.pack_start(label, False, False, 0)
        return box


def main():
    if len(sys.argv) > 1 and sys.argv[1] in ("-h", "--help"):
        print("usage: dclawos-settings (writes org.dclawos.settings "
              "directly)")
        return 0
    try:
        settings = Gio.Settings.new(SCHEMA_ID)
    except Exception as exc:
        print(f"dclawos-settings: schema {SCHEMA_ID} unavailable: {exc}",
              file=sys.stderr)
        print("dclawos-settings: the image build compiles this schema "
              "(hook 1002); a missing schema means a broken image.",
              file=sys.stderr)
        return 1
    log("dclawos-settings started (Phase 2 module 3: direct-write GUI)")
    win = SettingsApp(settings)
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()
    return 0


if __name__ == "__main__":
    sys.exit(main())
