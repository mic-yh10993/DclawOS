#!/usr/bin/env python3
"""DclawOS AI dashboard (Phase 2 module 2; Phase 6 module M4).

M4 rebuild: the window is now a WebView HOST around the local
dashboard page (/usr/share/dclawos/dashboard.html), following the
M2 settings / M3 chat host pattern (typed bridge
dispatch, event-bus subscription forwarding). All logic lives in
dashboardlib.DashboardHost (headless, gate-tested by
dashboardtest.py):

- The timeline is the pre-M4 event stream with identical
  semantics: the durable events file is read ONCE at startup for
  history (inside DashboardHost), after that freshness is the
  M1 event bus ONLY — bus events arrive on a subscriber thread
  and are marshalled into the GTK loop with GLib.idle_add; there
  is no display timer and the file is never re-read. Bus-only
  signals (data.display False) never become timeline rows, but
  takeover events still refresh the banner state (now a page
  element fed by host-pushed counts), exactly as before.
- Counts (running / waiting / done / failed tasks, token and
  cost totals) are recomputed BY THE HOST when a relevant bus
  event arrives and pushed to the page — no page polling, no
  host timer polling.
- The approval overlay lives on the page; verdicts are written
  by the host through chatlib.apply_verdict, the one shared
  dclawos-approve write path (see dashboardlib).
- If WebKit is unavailable the window degrades to an
  explanatory label (no second full UI is maintained). Phase 6
  M5: this host is GTK4 + WebKitGTK 6.0 (docs/UI-FUNCTIONS.md).

The binary name and launch entry are unchanged.

// reuse-check: WebView host shell ADOPTED from dclawos-chat
  (M3) — UserContentManager script handler, hello/command
  validation via bridgeprotocol, GLib.idle_add marshalling of
  page-bound JS, focus re-read push, dark-class on hello; the
  dashboard-specific parts are only the surface name, the page
  path and the DashboardHost instance.
// reuse-check: append_event/_share_event_file are KEPT from the
  pre-M4 dashboard (the startup "dashboard started" event other
  tooling may rely on), unchanged.
"""
import grp
import json
import os
import subprocess
import sys
import time

sys.path.insert(0, "/usr/local/lib/dclawos")
sys.path.insert(0, os.path.join(
    os.path.dirname(os.path.abspath(__file__)), "..", "lib",
    "dclawos"))

try:
    import bridgeprotocol
    import dashboardlib
    import settingslib
except ImportError:
    bridgeprotocol = None
    dashboardlib = None
    settingslib = None

try:
    import eventbus
except ImportError:
    eventbus = None

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gtk, GLib  # noqa: E402

EVENTS_PATH = os.environ.get("DCLAWOS_EVENTS_PATH",
                             "/var/lib/dclawos/events.jsonl")
DASHBOARD_PAGE_PATH = "/usr/share/dclawos/dashboard.html"


def log(msg):
    print(f"dclawos-dashboard: {msg}", flush=True)


def append_event(event):
    """Append one event dict to the stream (best effort, never fatal)."""
    try:
        os.makedirs(os.path.dirname(EVENTS_PATH), exist_ok=True)
        with open(EVENTS_PATH, "a", encoding="utf-8") as handle:
            handle.write(json.dumps(event, ensure_ascii=False) + "\n")
        _share_event_file()
        if eventbus is not None:
            eventbus.publish_event(event)
    except Exception as exc:
        log(f"event append failed (non-fatal): {exc}")


def _share_event_file():
    try:
        os.chown(EVENTS_PATH, -1,
                 grp.getgrnam(os.environ.get(
                     "DCLAWOS_SHARED_GROUP", "dclawos-session")).gr_gid)
    except (KeyError, OSError):
        pass
    try:
        os.chmod(EVENTS_PATH, 0o660)
    except OSError:
        pass


def _append_expand(box, child, expand=False):
    """GTK4 Box packing (pack_start/pack_end were removed): append
    (or prepend) and translate the old expand flag onto the child's
    expand property along the box orientation.
    // reuse-check: GTK4 migration idiom written for DclawOS; the
      helper exists so every pre-GTK4 pack call site keeps its
      expand semantics with the child evaluated exactly once."""
    box.append(child)
    if expand:
        if box.get_orientation() == Gtk.Orientation.VERTICAL:
            child.set_vexpand(True)
        else:
            child.set_hexpand(True)
    return child


def _prepend_expand(box, child, expand=False):
    box.prepend(child)
    if expand:
        if box.get_orientation() == Gtk.Orientation.VERTICAL:
            child.set_vexpand(True)
        else:
            child.set_hexpand(True)
    return child


def run_dialog(dialog):
    """GTK4 replacement for Gtk.Dialog.run() (removed in GTK4):
    present the dialog and run a nested GLib main loop until the
    dialog emits "response" (or is closed), then return the
    response id. Callers keep their synchronous shape; the dialog
    itself is a real GTK4 Dialog/FileChooser/MessageDialog.
    // reuse-check: pattern is the GTK4 migration guide's own
      response-signal idiom, adapted to a nested MainLoop so the
      pre-GTK4 call sites keep their control flow unchanged."""
    loop = GLib.MainLoop()
    holder = {"response": Gtk.ResponseType.CANCEL}

    def _on_response(_dialog, response):
        holder["response"] = response
        loop.quit()

    def _on_close(_dialog):
        loop.quit()
        return False

    dialog.connect("response", _on_response)
    dialog.connect("close-request", _on_close)
    dialog.present()
    loop.run()
    return holder["response"]


def run_window(window):
    """GTK4 main loop for a top-level window (Gtk.main() and the
    "destroy" signal were removed in GTK4): present the window and
    run a GLib main loop until it emits "close-request"."""
    loop = GLib.MainLoop()

    def _on_close(_window):
        loop.quit()
        return False

    window.connect("close-request", _on_close)
    window.present()
    loop.run()
    return 0


class DashboardWindow(Gtk.Window):
    def __init__(self):
        super().__init__(title="dclawos-dashboard")
        self.set_default_size(1024, 700)
        try:
            import theme
            theme.apply_theme()
        except ImportError:
            pass
        header = Gtk.HeaderBar()
        _title_box = Gtk.Box(
            orientation=Gtk.Orientation.VERTICAL, spacing=0)
        _title_label = Gtk.Label(label="AI 看板")
        _title_label.add_css_class("heading")
        _title_box.append(_title_label)
        _subtitle_label = Gtk.Label(label="AI 运行状态")
        _subtitle_label.add_css_class("dim-label")
        _title_box.append(_subtitle_label)
        header.set_title_widget(_title_box)
        self.set_titlebar(header)

        self.host = dashboardlib.DashboardHost() \
            if dashboardlib is not None else None
        self.webview = None

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.set_child(box)
        try:
            gi.require_version("WebKit", "6.0")
            from gi.repository import WebKit
        except (ImportError, ValueError) as exc:
            label = Gtk.Label(
                label=f"WebKitGTK 6.0 不可用（{exc}），看板 WebView "
                      "无法加载。事件流仍在写入事件文件，监视与设置"
                      "不受影响；本窗口不维护第二套界面。")
            label.set_wrap(True)
            label.set_halign(Gtk.Align.START)
            _append_expand(box, label, True)
            return
        manager = WebKit.UserContentManager()
        manager.register_script_message_handler("dclawos")
        manager.connect("script-message-received::dclawos",
                        self._on_bridge_message)
        try:
            webview = WebKit.WebView(user_content_manager=manager)
        except Exception:  # noqa: BLE001 - binding without the
            # construct property: plain view (bridge unavailable,
            # page still renders; host verbs are additive)
            webview = WebKit.WebView()
        self.webview = webview
        if os.path.exists(DASHBOARD_PAGE_PATH):
            webview.load_uri("file://" + DASHBOARD_PAGE_PATH)
        else:
            webview.load_html(
                "<html><body><p>看板页面资源缺失："
                + DASHBOARD_PAGE_PATH + "</p></body></html>",
                "file:///")
        _append_expand(box, webview, True)
        # Push: subscribe to the M1 event bus; dashboardlib folds
        # each event into host state and decides what the page
        # receives. Subscription lifecycle only — there is
        # deliberately no display polling timer here.
        self._subscriber = None
        if eventbus is not None:
            try:
                self._subscriber = eventbus.EventSubscriber(
                    self._on_bus_event_thread).start()
            except Exception as exc:  # noqa: BLE001 - push is additive
                log(f"event subscription unavailable: {exc}")
        _focus = Gtk.EventControllerFocus()
        _focus.connect("enter", self._on_focus_in)
        self.add_controller(_focus)

    # ------------------------------------------------------------ bridge

    def _on_focus_in(self, _controller):
        # Re-read shared state on focus (M2/M3 host pattern): the
        # page re-requests its state snapshot on this push.
        self._push_event("settings", {"reason": "focus"})
        return False

    def _on_bus_event_thread(self, event):
        # Subscriber thread: marshal into the GTK main loop.
        GLib.idle_add(self._on_bus_event_main, event)

    def _on_bus_event_main(self, event):
        if self.host is None:
            return False
        try:
            forwarded = self.host.handle_bus_event(event)
        except Exception:  # noqa: BLE001 - forwarding is additive
            return False
        for item in forwarded:
            self._push_event(item.get("type", "system"),
                             item.get("data") or {})
        return False

    def _push_event(self, event_type, data):
        if self.webview is None or bridgeprotocol is None:
            return
        try:
            message = bridgeprotocol.make_event(event_type, data)
        except Exception:  # noqa: BLE001
            return
        self._send_to_page(message)

    def _send_to_page(self, message):
        webview = self.webview
        if webview is None:
            return
        script = "window.__dclawosReceive && window.__dclawosReceive(" \
            + json.dumps(message, ensure_ascii=False) + ");"

        def _do():
            try:
                if hasattr(webview, "evaluate_javascript"):
                    webview.evaluate_javascript(
                        script, -1, None, None, None, None)
                else:
                    webview.run_javascript(script, None, None, None)
            except Exception:  # noqa: BLE001 - page may be reloading
                pass
            return False

        GLib.idle_add(_do)

    def _on_bridge_message(self, _manager, js_result):
        if bridgeprotocol is None or self.host is None:
            return
        try:
            try:
                value = js_result.get_js_value()
                text = value.to_string()
            except Exception:  # noqa: BLE001 - older binding shape
                text = js_result.to_string()
            message = json.loads(text)
        except Exception:  # noqa: BLE001 - untrusted input
            return
        if isinstance(message, dict) and message.get("kind") == "hello":
            try:
                bridgeprotocol.validate_hello(message)
            except bridgeprotocol.BridgeError as exc:
                self._send_to_page(exc.to_error(None))
                return
            self._send_to_page(
                bridgeprotocol.make_hello_ack("dashboard"))
            try:
                if settingslib is not None and \
                        settingslib.get_setting("ui-dark"):
                    script = "document.body.classList.add('dark');"

                    def _do_dark():
                        try:
                            if hasattr(self.webview,
                                       "evaluate_javascript"):
                                self.webview.evaluate_javascript(
                                    script, -1, None, None, None,
                                    None)
                            else:
                                self.webview.run_javascript(
                                    script, None, None, None)
                        except Exception:  # noqa: BLE001
                            pass
                        return False

                    GLib.idle_add(_do_dark)
            except Exception:  # noqa: BLE001
                pass
            return
        try:
            command = bridgeprotocol.validate_command(
                message, "dashboard")
        except bridgeprotocol.BridgeError as exc:
            request_id = message.get("id") if isinstance(
                message, dict) else None
            self._send_to_page(exc.to_error(request_id))
            return
        verb = command["command"]
        params = command["params"]
        request_id = command["id"]
        try:
            result = self.host.dispatch(verb, params)
        except Exception as exc:  # noqa: BLE001 - typed error reply
            self._send_to_page(bridgeprotocol.make_error(
                request_id, "handler_error", str(exc)[:500]))
            return
        self._send_to_page(bridgeprotocol.make_reply(
            request_id, result))


def main():
    if len(sys.argv) > 1 and sys.argv[1] in ("-h", "--help"):
        print("usage: dclawos-dashboard (reads /var/lib/dclawos/events.jsonl)")
        return 0
    log("dclawos-dashboard started (Phase 6 M4: WebView dashboard)")
    append_event({"ts": int(time.time()), "type": "system",
                  "summary": "AI 看板已启动，等待 agent 事件", "session": ""})
    Adw.init()
    win = DashboardWindow()
    win.maximize()
    return run_window(win)


if __name__ == "__main__":
    sys.exit(main())
