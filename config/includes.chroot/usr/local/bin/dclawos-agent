#!/usr/bin/env python3
"""DclawOS agent service daemon (Phase 3 module 1; Phase 4 module 2).

Runs as the dclaw-agent user via systemd (dclawos-agent.service).
Executes tasks from the task queue (/var/lib/dclawos/tasks/):
Phase 6 M1 made the queue event-driven — the daemon serves the
Unix-socket event bus (eventbus.py), is woken by inotify on the
tasks directory and by bus task events, and streams shell output
live as bus events. (Connector/channel inbound stays on its 30 s
cycle: external services have no local push channel.)

- kind "steps" (default): explicit tool steps (chat slash commands,
  assigned tasks, parent tasks), executed sequentially with approval
  gates, audit events and the cooperative stop flag. A steps task
  with no steps is recorded honestly as "no steps to execute".
- kind "llm" (Phase 4): the agent loop. The task goal is a user
  message in a persistent conversation (convlib transcripts); the
  loop calls the model through llmlib -> dclawos-llm (routing
  decision + dispatch + executor in the engine), turns model
  tool_calls into steps executed by the SAME execute_step approval
  path, feeds tool results back, and repeats until the model answers
  without tool calls (or the turn cap / stop flag hits). When no
  provider key is configured the task is recorded honestly as
  model-less; no reply is ever fabricated.

Tools (see agentlib.classify for the approval tier of each):
  shell, read_file, write_file, list_files, service_status,
  service_restart, package_install, route_decide, mcp_call,
  skill_run, subagent, takeover_request, connector_send,
  registry_list, skill_install, skill_remove, mcp_add,
  mcp_remove, channel_manage (Phase 5 WS2 self-provisioning:
  provisioninglib, validated installs with rollback),
  settings_get, settings_set (P5-M7: the shared settings file,
  settingslib; human-only keys refused before any ticket exists).
Privileged operations go through the ticket broker (root daemon):
the service never runs sudo itself and never holds privileges.

Reuse notes (evaluation cards §5/§6/§7/§9):
- The approve-before-execute ticket pattern follows OpenClaw's
  gateway approval pattern; the transport is DclawOS ticket files.
// reuse-check: openclaw agent-step loop NOT copied, reason: the
  gateway loop assumes an LLM + gateway session; DclawOS steps are
  explicit tool steps from a task file, so this loop is DclawOS-written.
// reuse-check: openclaw computer-tool NOT copied here, reason: GUI
  operation lives in dclawos-gui (Phase 2 module 6) and is reached
  through the broker/takeover path, not re-implemented in the daemon.
"""

import argparse
import fcntl
import json
import os
import subprocess
import sys
import time

sys.path.insert(0, "/usr/local/lib/dclawos")
sys.path.insert(0, os.path.join(
    os.path.dirname(os.path.abspath(__file__)), "..", "lib", "dclawos"))

import agentlib  # noqa: E402

# Phase 6 M1: the task queue is woken by inotify on the tasks
# directory and by task events on the event bus (see serve_forever).
# TASK_FALLBACK_SECONDS is a documented SAFETY FALLBACK only: if
# inotify is unavailable, or a writer bypassed both the file watch
# and the bus, a queued task is still picked up within this bound.
# It is NOT the normal freshness path.
TASK_FALLBACK_SECONDS = 30
CONNECTOR_CYCLE_SECONDS = 30
MAX_PARALLEL = 3
SHELL_TIMEOUT_DEFAULT = 120
SHELL_OUTPUT_CAP = 8192
READ_SIZE_CAP = 1024 * 1024


def log(msg):
    print(f"dclawos-agent: {msg}", flush=True)


def _run_shell(params, context=None):
    """Run one shell command, streaming output LIVE (Phase 6 M1).

    stdout/stderr chunks are published as "output" events (via
    agentlib.log_event, so they land in the durable log AND on the
    bus) WHILE the process runs — reader threads drain the pipes
    as data arrives, not after exit. Start/finish are "command"
    events. The result contract is unchanged from the previous
    subprocess.run implementation: {returncode, stdout, stderr}
    with stdout/stderr tail-capped at SHELL_OUTPUT_CAP, and the
    same ValueError messages for not-found / timeout / OSError.
    Context (task_id, session, step, tool) rides in the events'
    data where execute_step supplied it.
    """
    import threading as _threading
    argv = params.get("argv")
    if not isinstance(argv, list) or not argv or \
            not all(isinstance(a, str) for a in argv):
        raise ValueError("shell needs an 'argv' list of strings")
    cwd = params.get("cwd") or agentlib.agent_workspace()
    timeout = params.get("timeout") or SHELL_TIMEOUT_DEFAULT
    context = context or {}
    session = context.get("session", "")
    task_id = context.get("task_id")

    def _emit(stream, chunk):
        agentlib.log_event(
            "output",
            f"shell {stream}: {chunk[:200]}",
            session=session, task_id=task_id,
            data={"stream": stream, "chunk": chunk,
                  "tool": "shell", "step": context.get("step"),
                  "task_id": task_id})

    agentlib.log_event(
        "command", f"shell started: {argv[0]}",
        session=session, task_id=task_id,
        data={"tool": "shell", "step": context.get("step"),
              "task_id": task_id, "phase": "start"})
    try:
        proc = subprocess.Popen(argv, cwd=cwd,
                                stdout=subprocess.PIPE,
                                stderr=subprocess.PIPE)
    except FileNotFoundError:
        raise ValueError(f"command not found: {argv[0]!r}")
    except OSError as exc:
        raise ValueError(f"shell failed: {exc}")
    captured = {"stdout": [], "stderr": []}

    def _reader(stream_name, pipe):
        try:
            while True:
                chunk = os.read(pipe.fileno(), 4096)
                if not chunk:
                    break
                text = chunk.decode("utf-8", "replace")
                captured[stream_name].append(text)
                try:
                    _emit(stream_name, text)
                except Exception:  # noqa: BLE001 - events are additive
                    pass
        except OSError:
            pass

    readers = [
        _threading.Thread(target=_reader, args=("stdout", proc.stdout),
                          daemon=True),
        _threading.Thread(target=_reader, args=("stderr", proc.stderr),
                          daemon=True),
    ]
    for reader in readers:
        reader.start()
    try:
        proc.wait(timeout=timeout)
    except subprocess.TimeoutExpired:
        proc.kill()
        try:
            proc.wait(timeout=5)
        except subprocess.TimeoutExpired:
            pass
        for reader in readers:
            reader.join(timeout=2)
        raise ValueError(f"shell timed out after {timeout}s")
    for reader in readers:
        reader.join(timeout=5)
    out = "".join(captured["stdout"])[-SHELL_OUTPUT_CAP:]
    err = "".join(captured["stderr"])[-SHELL_OUTPUT_CAP:]
    agentlib.log_event(
        "command", f"shell finished: {argv[0]} rc={proc.returncode}",
        session=session, task_id=task_id,
        data={"tool": "shell", "step": context.get("step"),
              "task_id": task_id, "phase": "finish",
              "returncode": proc.returncode})
    return {"returncode": proc.returncode, "stdout": out, "stderr": err}


def _read_file(params):
    path = params.get("path")
    if not isinstance(path, str) or not path:
        raise ValueError("read_file needs a path")
    real = os.path.realpath(path)
    if os.path.getsize(real) > READ_SIZE_CAP:
        raise ValueError("read_file file too large (>1MB)")
    with open(real, "r", encoding="utf-8", errors="replace") as handle:
        return {"path": real, "content": handle.read()}


def _write_file(params):
    path = params.get("path")
    content = params.get("content")
    if not isinstance(path, str) or not path:
        raise ValueError("write_file needs a path")
    if not isinstance(content, str):
        raise ValueError("write_file needs string content")
    real = os.path.realpath(path)
    parent = os.path.dirname(real)
    if parent:
        os.makedirs(parent, exist_ok=True)
    with open(real, "w", encoding="utf-8") as handle:
        handle.write(content)
    return {"path": real, "bytes": len(content.encode("utf-8"))}


def _list_files(params):
    path = params.get("path") or agentlib.agent_workspace()
    if not isinstance(path, str) or not path:
        raise ValueError("list_files needs a path")
    names = sorted(os.listdir(path))
    return {"path": path, "entries": names}


def _edit_file(params):
    path = params.get("path")
    old = params.get("old_text")
    new = params.get("new_text")
    if not isinstance(path, str) or not path:
        raise ValueError("edit_file needs a path")
    if not isinstance(old, str) or not old:
        raise ValueError("edit_file needs non-empty old_text")
    if not isinstance(new, str):
        raise ValueError("edit_file needs string new_text")
    real = os.path.realpath(path)
    with open(real, "r", encoding="utf-8") as handle:
        content = handle.read()
    count = content.count(old)
    if count == 0:
        raise ValueError("edit_file: old_text not found")
    if count > 1:
        raise ValueError(
            f"edit_file: old_text occurs {count} times, must be unique")
    with open(real, "w", encoding="utf-8") as handle:
        handle.write(content.replace(old, new, 1))
    return {"path": real, "replacements": 1}


PROCESSES = {}
PROCESS_LOG_CAP = 8192


def _process(params):
    # Phase 6 M1 boundary (recorded in docs/PHASE6.md): the
    # background `process` tool is NOT live-streamed. Its output
    # goes to a per-process log file that the `log` action reads
    # back — a shape callers already poll deliberately — and its
    # lifecycle is detached from any step, so there is no step
    # context to stream against. Making it genuinely live needs a
    # reader-thread + log-cursor redesign of this store; faking it
    # by re-emitting the log file on a timer was rejected. The
    # foreground `shell` tool IS live (see _run_shell).
    action = params.get("action")
    if action == "start":
        argv = params.get("argv")
        if not isinstance(argv, list) or not argv or \
                not all(isinstance(a, str) for a in argv):
            raise ValueError("process start needs an 'argv' list")
        import secrets as _secrets
        proc_id = _secrets.token_hex(6)
        log_path = f"/tmp/dclawos-process-{proc_id}.log"
        log_handle = open(log_path, "ab")
        proc = subprocess.Popen(
            argv, cwd=agentlib.agent_workspace(),
            stdout=log_handle, stderr=subprocess.STDOUT)
        PROCESSES[proc_id] = {"proc": proc, "log": log_path,
                              "argv": argv}
        return {"process_id": proc_id, "pid": proc.pid,
                "status": "running"}
    proc_id = params.get("process_id")
    entry = PROCESSES.get(proc_id or "")
    if entry is None:
        raise ValueError(f"unknown process_id: {proc_id!r}")
    proc = entry["proc"]
    if action == "poll":
        code = proc.poll()
        return {"process_id": proc_id,
                "status": "running" if code is None else "exited",
                "returncode": code}
    if action == "log":
        try:
            with open(entry["log"], "rb") as handle:
                data = handle.read()[-PROCESS_LOG_CAP:]
            return {"process_id": proc_id,
                    "log": data.decode("utf-8", "replace")}
        except OSError as exc:
            raise ValueError(f"process log unreadable: {exc}")
    if action == "kill":
        proc.terminate()
        try:
            proc.wait(timeout=5)
        except subprocess.TimeoutExpired:
            proc.kill()
        return {"process_id": proc_id, "status": "killed"}
    raise ValueError(f"unknown process action: {action!r}")


def _web_fetch(params):
    import re as _re
    import urllib.request
    url = params.get("url")
    if not isinstance(url, str) or not url.startswith(
            ("http://", "https://")):
        raise ValueError("web_fetch needs an http(s) url")
    request = urllib.request.Request(
        url, headers={"User-Agent": "DclawOS-agent/2.0"})
    with urllib.request.urlopen(request, timeout=30) as response:
        raw = response.read(1024 * 1024)
        ctype = response.headers.get_content_type()
    text = raw.decode("utf-8", "replace")
    if ctype == "text/html":
        text = _re.sub(r"<script[\s\S]*?</script>", " ", text)
        text = _re.sub(r"<style[\s\S]*?</style>", " ", text)
        text = _re.sub(r"<[^>]+>", " ", text)
        text = _re.sub(r"\s+", " ", text).strip()
    return {"url": url, "content_type": ctype,
            "text": text[:PROCESS_LOG_CAP]}


def _broker_tool(ticket_id, operation, params):
    reply = agentlib.broker_execute(ticket_id, operation, params)
    if not reply.get("ok"):
        raise ValueError(f"broker refused: {reply.get('error')}")
    return reply.get("result")


def _unit_params(params):
    """WS2 audit §2 (latent bug): the model-facing schemas name
    the service param {name}; the broker validates {unit}. Both
    shapes are accepted here; the broker always receives {unit}."""
    out = dict(params)
    if not out.get("unit") and out.get("name"):
        out["unit"] = out["name"]
    return out


def _package_params(params):
    """Same audit fix as _unit_params, for {name} -> {package}."""
    out = dict(params)
    if not out.get("package") and out.get("name"):
        out["package"] = out["name"]
    return out


def _route_decide(params):
    proc = subprocess.run(["dclawos-route"], input=None,
                          capture_output=True, text=True, timeout=60)
    if proc.returncode != 0:
        raise ValueError(f"dclawos-route failed: {proc.stderr.strip()}")
    try:
        return json.loads(proc.stdout)
    except ValueError:
        raise ValueError("dclawos-route output not valid JSON")


def _settings_get(params):
    import settingslib
    key = params.get("key")
    if key is None:
        return {"settings": settingslib.load_settings(),
                "agent_denied_keys":
                    sorted(settingslib.AGENT_DENIED_KEYS)}
    if not isinstance(key, str):
        raise ValueError("settings_get needs a string 'key'")
    return {"key": key, "value": settingslib.get_setting(key)}


def _settings_set(params, task, ticket_id):
    """Execute settings_set in the root broker (P5-M7 hardening).

    The daemon never writes the settings file itself — as
    dclaw-agent it only has READ access to it (0640 in a 0710
    directory), which is deliberate: its shell tool must not be
    able to edit settings around the library. The broker's
    set-setting op re-checks the human-only denylist in root code,
    validates, writes, and logs the change event; the broker
    params are exactly the ticketed {key, value}.
    """
    key = params.get("key")
    if not isinstance(key, str) or not key:
        raise ValueError("settings_set needs a 'key'")
    if "value" not in params:
        raise ValueError("settings_set needs a 'value'")
    result = _broker_tool(ticket_id, "set-setting",
                          {"key": key, "value": params["value"]})
    agentlib.log_event(
        "settings",
        f"settings_set {key} applied via broker "
        f"(ticket {ticket_id})",
        session=task.get("session", ""))
    return result


def _takeover_request(params):
    import takeoverlib
    kind = params.get("kind", "other")
    message = params.get("message", "")
    request = takeoverlib.new_request(kind, message,
                                      params.get("app_hint", ""))
    takeoverlib.ensure_dir(takeoverlib.requests_dir())
    takeoverlib.save_request(request)
    timeout = params.get("timeout") or 600
    deadline = time.time() + timeout
    while time.time() < deadline:
        if agentlib.stop_requested():
            return {"request_id": request["id"], "outcome": "cancelled"}
        try:
            current = takeoverlib.load_request(request["id"])
        except (OSError, ValueError):
            return {"request_id": request["id"], "outcome": "expired"}
        if current.get("status") in ("done", "failed", "cancelled"):
            result = current.get("result") or {}
            return {"request_id": request["id"],
                    "outcome": result.get("outcome", "fail"),
                    "session_handle": result.get("session_handle", "")}
        time.sleep(2)
    return {"request_id": request["id"], "outcome": "timeout"}


MAX_SUBAGENT_DEPTH = 3


def _subagent(params, task):
    if int(task.get("depth", 0)) >= MAX_SUBAGENT_DEPTH:
        raise ValueError(
            f"subagent depth limit reached ({MAX_SUBAGENT_DEPTH})")
    goal = params.get("goal", "")
    steps = params.get("steps") or []
    child = agentlib.new_task(f"subagent of {task['id']}", goal, steps,
                              parent=task["id"])
    child["depth"] = int(task.get("depth", 0)) + 1
    if not steps and goal:
        # Goal-only delegation runs the child as an LLM task with its
        # own conversation (Phase 4 module 2/5).
        child["kind"] = "llm"
        child["conv_session"] = child["session"]
    if params.get("model"):
        child["model"] = params["model"]
    if params.get("provider"):
        child["provider"] = params["provider"]
    # Phase 6 M2: subagent default pin (registry model_config
    # subagent_pin) applies only when the child carries no explicit
    # pin of its own (explicit pin > subagent default > the normal
    # llmlib resolution chain). // reuse-check: pin storage ADOPTED
    # from registrylib.normalize_model_config's subagent_pin; the
    # child task's provider/model fields are the pre-existing
    # subagent pin channel (run_llm_task already forwards them).
    if not child.get("provider") or not child.get("model"):
        try:
            import registrylib as _registrylib
            _data, _skipped = _registrylib.load_registry()
            _pin = (_data.get("model_config") or {}).get(
                "subagent_pin") or {}
            if _pin.get("provider") and not child.get("provider"):
                child["provider"] = _pin["provider"]
            if _pin.get("model") and not child.get("model"):
                child["model"] = _pin["model"]
        except Exception:  # noqa: BLE001 - default pin is additive
            pass
    agentlib.save_task(child)
    agentlib.log_event("system",
                       f"subagent task {child['id']} started",
                       session=task["session"])
    # The daemon is single-threaded: the child is executed INLINE by
    # this same run (recursion), never left for the queue — a queued
    # child could never start while the parent occupies the runner
    # (the Phase 3 poll-for-completion shape deadlocked by design;
    # fixed here and recorded in docs/PHASE4-GAP.md row C1).
    run_task(child)
    current = agentlib.load_task(child["id"])
    result = current.get("result") or {}
    return {"child_id": child["id"],
            "status": current.get("status"),
            "reply": result.get("reply"),
            "result": result,
            "error": current.get("error")}


def execute_step(task, step, step_index=None):
    """Execute one step dict {tool, params}. Returns the step result.

    Approval is enforced here, not in the tools: tier 0 runs free,
    tiers 1-2 need an approved ticket (or full-access auto-approval).
    Unknown tools fail closed via classify().
    """
    tool = step.get("tool")
    params = step.get("params") or {}
    tier, reason = agentlib.classify(tool, params)
    if tool == "settings_set":
        # Human-only settings keys fail closed BEFORE any ticket
        # exists: no approval — and no full-access auto-approval —
        # may let the agent set its own permission grant or its
        # fault-injection switch (P5-M7, settingslib denylist).
        import settingslib
        _skey = params.get("key")
        if isinstance(_skey, str) and settingslib.agent_denied(_skey):
            agentlib.log_event(
                "settings",
                f"settings_set DENIED (human-only key): {_skey}",
                session=task.get("session", ""))
            raise ValueError(
                f"settings_set: {_skey!r} is human-only; the agent "
                f"can never set it")
    ticket_id = None
    if tier > 0:
        summary = f"{tool} {json.dumps(params, ensure_ascii=False)[:200]}"
        if tool == "settings_set":
            # The settings write executes in the root broker
            # (P5-M7 hardening): the ticket must therefore carry
            # the BROKER operation name and exactly the broker
            # params {key, value} — the ticket's params hash binds
            # execution to what the human approved (the same shape
            # as the write-secret flow in dclawos-secret).
            broker_params = {"key": params.get("key"),
                             "value": params.get("value")}
            verdict, ticket_id = agentlib.request_approval(
                "set-setting", broker_params, summary,
                task_id=task.get("id"), session=task.get("session", ""))
        else:
            verdict, ticket_id = agentlib.request_approval(
                tool, params, summary,
                task_id=task.get("id"), session=task.get("session", ""))
        if verdict != "approved":
            raise ValueError(f"approval {verdict} for {tool} ({reason})")
    if tool == "shell":
        return _run_shell(params, context={
            "task_id": task.get("id"), "session": task.get("session", ""),
            "step": step_index, "tool": tool})
    if tool == "read_file":
        return _read_file(params)
    if tool == "write_file":
        return _write_file(params)
    if tool == "edit_file":
        return _edit_file(params)
    if tool == "process":
        return _process(params)
    if tool == "web_fetch":
        return _web_fetch(params)
    if tool == "list_files":
        return _list_files(params)
    if tool == "service_status":
        return _broker_tool(ticket_id, "service-status",
                            _unit_params(params))
    if tool == "service_restart":
        return _broker_tool(ticket_id, "restart-service",
                            _unit_params(params))
    if tool == "package_install":
        return _broker_tool(ticket_id, "package-install",
                            _package_params(params))
    if tool == "route_decide":
        return _route_decide(params)
    if tool == "mcp_call":
        import mcpclient
        return mcpclient.call_tool(params, ticket_id)
    if tool == "skill_run":
        import skills
        return skills.run_skill(params, ticket_id)
    if tool == "connector_send":
        import connectorlib
        return connectorlib.send_message(
            params.get("connector", ""), params.get("message", ""))
    if tool == "registry_list":
        import provisioninglib
        return provisioninglib.registry_list(params)
    if tool == "skill_install":
        import provisioninglib
        return provisioninglib.skill_install(params)
    if tool == "skill_remove":
        import provisioninglib
        return provisioninglib.skill_remove(params)
    if tool == "mcp_add":
        import provisioninglib
        return provisioninglib.mcp_add(params)
    if tool == "mcp_remove":
        import provisioninglib
        return provisioninglib.mcp_remove(params)
    if tool == "channel_manage":
        import provisioninglib
        return provisioninglib.channel_manage(params)
    if tool == "settings_get":
        return _settings_get(params)
    if tool == "settings_set":
        return _settings_set(params, task, ticket_id)
    if tool == "subagent":
        return _subagent(params, task)
    if tool == "cron":
        return _cron(params)
    if tool == "memory_save":
        import memorylib
        return memorylib.save(params.get("text", ""),
                              params.get("tag") or "note")
    if tool == "memory_search":
        import memorylib
        return memorylib.search(params.get("query", ""))
    if tool == "takeover_request":
        return _takeover_request(params)
    raise ValueError(f"unknown tool: {tool!r}")


def _cron(params):
    import cronlib
    action = params.get("action")
    if action == "list":
        return {"jobs": cronlib.list_jobs()}
    if action == "add":
        schedule = params.get("schedule")
        goal = params.get("goal")
        if not isinstance(schedule, str) or not schedule:
            raise ValueError("cron add needs a 'schedule'")
        if not isinstance(goal, str) or not goal:
            raise ValueError("cron add needs a 'goal'")
        return {"job": cronlib.add_job(schedule, goal)}
    if action == "remove":
        job_id = params.get("job_id")
        if not job_id or not cronlib.remove_job(job_id):
            raise ValueError(f"unknown cron job: {job_id!r}")
        return {"removed": job_id}
    raise ValueError(f"unknown cron action: {action!r}")


LLM_MAX_TURNS = 12
# Phase 6 M3 delta coalescing for the event bus (see run_llm_task).
STREAM_COALESCE_CHARS = 48
STREAM_COALESCE_SECONDS = 0.25
LLM_TOOL_RESULT_CAP = 8000

SYSTEM_PROMPT = (
    "You are the DclawOS system agent. You operate this machine for "
    "the user through tools; every mutating tool call passes a "
    "human approval gate, so propose actions plainly and never "
    "claim an action succeeded unless its tool result says so. "
    "Agent workspace: /home/dclaw-agent/workspace. Deleting files "
    "and anything outside the workspace needs explicit approval. "
    "Answer in the user's language."
)


def _message_text(message):
    content = message.get("content")
    return content if isinstance(content, str) else ""


COMPACT_AFTER_MESSAGES = 40


def _maybe_compact(conv_session):
    """Summarize an over-long transcript into a compaction entry
    (gap row C3). OpenClaw's compaction replaces covered history
    with an LLM-written summary; convlib.project_messages already
    projects that shape. Failure to summarize is non-fatal: the
    loop proceeds with the full transcript."""
    import convlib
    import llmlib
    entries = convlib.load_entries(conv_session)
    last_compaction = -1
    for index, entry in enumerate(entries):
        if entry.get("kind") == "compaction":
            last_compaction = index
    pending = [e for e in entries[last_compaction + 1:]
               if e.get("kind") == "message"]
    if len(pending) <= COMPACT_AFTER_MESSAGES:
        return
    history = [e["message"] for e in pending
               if isinstance(e.get("message"), dict)]
    prompt = history + [{
        "role": "user",
        "content": "Summarize the conversation above into a "
                   "compact brief that preserves facts, decisions, "
                   "names, paths and open threads. Be specific; "
                   "this summary replaces the original messages.",
    }]
    try:
        result = llmlib.call(prompt, tools=None)
    except Exception as exc:  # noqa: BLE001 - compaction is optional
        agentlib.log_event("system",
                           f"compaction skipped: {exc}",
                           session=conv_session)
        return
    response = result.get("response") or {}
    choices = response.get("choices") or []
    summary = ""
    if choices:
        summary = str((choices[0].get("message") or {}).get(
            "content") or "")
    if not summary:
        return
    convlib.append_entry(conv_session, {
        "kind": "compaction",
        "summary": summary[:8000],
        "covers": len(pending),
    })
    agentlib.log_event(
        "system",
        f"compacted {len(pending)} messages into a summary",
        session=conv_session)


def run_llm_task(task):
    """The agent loop (gap rows A4/A6/A7). Returns the task dict."""
    import convlib
    import llmlib
    import toolslib

    conv_session = task.get("conv_session") or task["session"]
    goal = task.get("goal") or ""
    convlib.ensure_session(conv_session, title=goal[:60])
    if not llmlib.provider_configured():
        task["status"] = "done"
        task["result"] = {
            "note": "no provider configured: no model reply produced",
            "model_configured": False,
        }
        agentlib.log_event(
            "system",
            "llm task recorded honestly: no provider key configured",
            session=task["session"])
        agentlib.save_task(task)
        return task
    if goal:
        convlib.append_message(conv_session,
                               {"role": "user", "content": goal})
    total_cost = 0.0
    cost_known = False
    try:
        for turn in range(LLM_MAX_TURNS):
            if agentlib.stop_requested():
                task["status"] = "cancelled"
                task["error"] = "stopped by human"
                agentlib.save_task(task)
                return task
            _maybe_compact(conv_session)
            messages = convlib.project_messages(conv_session,
                                                SYSTEM_PROMPT)
            # Phase 6 M3: streaming call. Deltas are published as
            # "llm" bus events (agentlib.log_event writes the
            # durable log first, then the bus) carrying task_id,
            # the conversation session and the turn number.
            # Coalescing: fragments accumulate until
            # STREAM_COALESCE_CHARS (48) chars are buffered OR
            # STREAM_COALESCE_SECONDS (0.25 s) elapsed since the
            # last publish, whichever first; any remainder is
            # flushed when the call returns. This keeps a chatty
            # token stream from flooding the bus while staying
            # well under a second of added latency.
            _stream_state = {"buf": "", "last": 0.0, "seq": 0}

            def _publish_delta(force=False):
                buf = _stream_state["buf"]
                if not buf:
                    return
                if not force and len(buf) < STREAM_COALESCE_CHARS \
                        and (time.time() - _stream_state["last"]) \
                        < STREAM_COALESCE_SECONDS:
                    return
                _stream_state["buf"] = ""
                _stream_state["last"] = time.time()
                _stream_state["seq"] += 1
                agentlib.log_event(
                    "llm", f"llm delta turn {turn} "
                    f"seq {_stream_state['seq']}",
                    session=task["session"], task_id=task.get("id"),
                    data={"delta": buf, "stream_mode": "sse",
                          "conv_session": conv_session, "turn": turn,
                          "seq": _stream_state["seq"],
                          "task_id": task.get("id")})

            def _on_delta(delta):
                text = delta.get("text") or ""
                if not text:
                    return
                if delta.get("stream_mode") == "staged":
                    # Staged (non-SSE) path: the fragment carries
                    # its honest mode; publish it as-is, in one go.
                    _stream_state["buf"] += text
                    agentlib.log_event(
                        "llm", f"llm staged turn {turn}",
                        session=task["session"], task_id=task.get("id"),
                        data={"delta": _stream_state["buf"],
                              "stream_mode": "staged",
                              "conv_session": conv_session,
                              "turn": turn,
                              "seq": _stream_state["seq"] + 1,
                              "task_id": task.get("id")})
                    _stream_state["buf"] = ""
                    _stream_state["seq"] += 1
                    return
                _stream_state["buf"] += text
                _publish_delta()

            result = llmlib.call_stream(
                messages, tools=toolslib.tools_for_model(),
                provider=task.get("provider"),
                model=task.get("model"),
                task_id=task.get("id"),
                session=task.get("session"), on_delta=_on_delta)
            _publish_delta(force=True)
            response = result.get("response")
            if not response:
                task["status"] = "failed"
                if result.get("partial"):
                    # Phase 6 M3: the stream already showed partial
                    # content; close honestly as a partial failure,
                    # never as a clean attempt failure.
                    task["error"] = (
                        "stream interrupted after partial content "
                        "(partial): " + str(result.get("error") or "")
                        )[:400]
                    task["result"] = {"partial": True,
                                      "stream_mode":
                                          result.get("stream_mode")}
                else:
                    task["error"] = (
                        "all provider attempts failed: " +
                        json.dumps(result.get("attempts", []),
                                   ensure_ascii=False)[:400])
                agentlib.log_event(
                    "system", "llm call failed on every target",
                    session=task["session"])
                agentlib.save_task(task)
                return task
            if result.get("costUsd") is not None:
                total_cost += float(result["costUsd"])
                cost_known = True
            agentlib.log_event(
                "llm",
                f"turn {turn}: {result.get('provider')}/"
                f"{result.get('model')} cost_usd="
                f"{result.get('costUsd')}",
                session=task["session"])
            choices = response.get("choices") or []
            message = (choices[0].get("message") if choices else None) \
                or {"role": "assistant", "content": ""}
            assistant = {"role": "assistant",
                         "content": _message_text(message)}
            if message.get("tool_calls"):
                assistant["tool_calls"] = message["tool_calls"]
            convlib.append_message(conv_session, assistant)
            tool_calls = message.get("tool_calls") or []
            if not tool_calls:
                task["status"] = "done"
                task["result"] = {
                    "reply": assistant["content"],
                    "provider": result.get("provider"),
                    "model": result.get("model"),
                    "cost_usd": total_cost if cost_known else None,
                    "turns": turn + 1,
                    "stream_mode": result.get("stream_mode"),
                }
                agentlib.log_event(
                    "system", f"llm task done in {turn + 1} turns",
                    session=task["session"])
                agentlib.save_task(task)
                return task
            for call in tool_calls:
                if agentlib.stop_requested():
                    task["status"] = "cancelled"
                    task["error"] = "stopped by human"
                    agentlib.save_task(task)
                    return task
                try:
                    step = toolslib.parse_tool_call(call)
                except ValueError as exc:
                    tool_result = {"error": str(exc)}
                else:
                    agentlib.log_event(
                        "command",
                        f"llm tool call: {step['tool']}",
                        session=task["session"])
                    try:
                        tool_result = execute_step(task, step)
                    except Exception as exc:  # noqa: BLE001 - data
                        tool_result = {"error": str(exc)}
                convlib.append_message(conv_session, {
                    "role": "tool",
                    "tool_call_id": call.get("id", ""),
                    "content": json.dumps(
                        tool_result, ensure_ascii=False,
                        default=str)[:LLM_TOOL_RESULT_CAP],
                })
        task["status"] = "failed"
        task["error"] = f"turn cap reached ({LLM_MAX_TURNS})"
        agentlib.save_task(task)
        return task
    except ValueError as exc:
        task["status"] = "failed"
        task["error"] = str(exc)
        agentlib.log_event("system", f"llm task failed: {exc}",
                           session=task["session"])
        agentlib.save_task(task)
        return task


def run_task(task):
    """Run one task to completion. Returns the updated task dict."""
    task["status"] = "running"
    agentlib.save_task(task)
    if task.get("kind") == "llm":
        return run_llm_task(task)
    agentlib.log_event("system", f"task started: {task['title']}",
                       session=task["session"])
    results = []
    try:
        steps = task.get("steps") or []
        if not steps:
            task["status"] = "done"
            task["result"] = {"note": "no steps to execute"}
            agentlib.log_event(
                "system",
                "task has no steps; recorded honestly, no LLM answer "
                "pretended", session=task["session"])
            agentlib.save_task(task)
            return task
        for index, step in enumerate(steps):
            if agentlib.stop_requested():
                task["status"] = "cancelled"
                task["error"] = "stopped by human"
                agentlib.log_event("system", "task cancelled by stop flag",
                                   session=task["session"])
                agentlib.save_task(task)
                return task
            task["current"] = index
            agentlib.save_task(task)
            tool = step.get("tool", "?")
            agentlib.log_event("command", f"step {index}: {tool}",
                               session=task["session"])
            try:
                results.append(execute_step(task, step,
                                            step_index=index))
            except Exception as exc:  # noqa: BLE001 - step errors are data
                task["status"] = "failed"
                task["error"] = str(exc)
                agentlib.log_event("system",
                                   f"task failed at step {index}: {exc}",
                                   session=task["session"])
                agentlib.save_task(task)
                return task
        task["status"] = "done"
        task["result"] = {"steps": len(results), "results": results}
        agentlib.log_event("system",
                           f"task done: {len(results)} steps",
                           session=task["session"])
    finally:
        if task["status"] == "running":
            task["status"] = "failed"
            task["error"] = "interrupted"
    agentlib.save_task(task)
    return task



# ------------------------------------------------------------------
# Connector inbound runtime (Phase 4 module 8, gap row C4).
# The daemon polls enabled connectors that implement the "poll"
# action; each inbound event becomes an llm task bound to a
# per-connector conversation, and when the task finishes its
# final reply is sent back through the same connector. Pending
# replies persist in a JSON file so a daemon restart does not
# lose a delivery.
# ------------------------------------------------------------------

# Connector/channel inbound runs on a time cycle in serve_forever
# (CONNECTOR_CYCLE_SECONDS, Phase 6 M1): those are EXTERNAL services
# with no local push channel, unlike the local task queue, which is
# event-driven. Their cycle bound is unchanged in effect (30 s).


def _connector_pending_path():
    return os.environ.get(
        "DCLAWOS_CONNECTOR_PENDING",
        "/var/lib/dclawos/connector-pending.json")


def _load_pending():
    try:
        with open(_connector_pending_path(), "r",
                  encoding="utf-8") as handle:
            data = json.load(handle)
        if isinstance(data, dict):
            return data
    except (OSError, ValueError):
        pass
    return {}


def _save_pending(pending):
    path = _connector_pending_path()
    parent = os.path.dirname(path)
    if parent:
        agentlib.ensure_exchange_dir(parent)
    agentlib.atomic_write(
        path, json.dumps(pending, indent=2, sort_keys=True) + "\n")


def _connector_session(connector_id):
    import hashlib
    return hashlib.sha256(
        ("connector:" + connector_id).encode("utf-8")).hexdigest()[:16]


# ------------------------------------------------------------------
# Third-party channel inbound (Phase 5, WS1). Same runtime shape
# as connectors above — poll on the same cycle, llm tasks, the
# SAME pending-reply file — with two differences: the conversation
# is per (channel, chat) so two owners on one bot do not share a
# transcript, and replies are addressed back to the originating
# chat via channellib. Allowlist filtering happens inside
# channellib before any event reaches this function, so a task is
# only ever created for an allowlisted sender.
# ------------------------------------------------------------------

def _channel_session(channel_id, chat_id):
    import hashlib
    return hashlib.sha256(
        ("channel:" + channel_id + ":" + str(chat_id)).encode(
            "utf-8")).hexdigest()[:16]


def _poll_channels():
    import channellib
    pending = _load_pending()
    changed = False
    for entry in channellib.list_channels():
        channel_id = entry["id"]
        result = channellib.poll_channel(entry)
        if not result.get("ok"):
            log(f"channel {channel_id} poll error: "
                f"{result.get('error')}")
            continue
        for event in result.get("events", []):
            task = agentlib.new_task(
                f"channel {channel_id}", event["text"], [])
            task["kind"] = "llm"
            task["conv_session"] = _channel_session(
                channel_id, event["chat"])
            agentlib.save_task(task)
            pending[task["id"]] = {"channel": channel_id,
                                   "chat": event["chat"]}
            changed = True
            agentlib.log_event(
                "system",
                f"channel {channel_id} inbound -> task {task['id']}",
                session=task["session"])
    if changed:
        _save_pending(pending)


def _poll_connectors():
    import connectorlib
    pending = _load_pending()
    changed = False
    for connector in connectorlib.list_connectors():
        connector_id = connector["id"]
        try:
            result = connectorlib.poll_events(connector_id)
        except ValueError:
            continue  # disabled/unknown between list and poll
        if not result.get("ok"):
            if not result.get("unsupported"):
                log(f"connector {connector_id} poll error: "
                    f"{result.get('error')}")
            continue
        for event in result.get("events", []):
            task = agentlib.new_task(
                f"connector {connector_id}", event["text"], [])
            task["kind"] = "llm"
            task["conv_session"] = _connector_session(connector_id)
            agentlib.save_task(task)
            pending[task["id"]] = {"connector": connector_id}
            changed = True
            agentlib.log_event(
                "system",
                f"connector {connector_id} inbound -> task "
                f"{task['id']}",
                session=task["session"])
    if changed:
        _save_pending(pending)


def _deliver_reply(info, reply):
    """Send one finished task's reply back via its origin route.

    info is the pending-map value: {"connector": id} (Phase 4) or
    {"channel": id, "chat": chat_id} (Phase 5). Returns nothing;
    failures are logged, never retried silently forever — the
    pending entry is dropped by the caller either way.
    """
    if info.get("channel"):
        import channellib
        channel_id = info["channel"]
        try:
            outcome = channellib.send_message(
                channel_id, info.get("chat", ""), reply)
            if not outcome.get("ok"):
                log(f"channel {channel_id} reply failed: "
                    f"{outcome.get('error')}")
        except Exception as exc:  # noqa: BLE001 - delivery is additive
            log(f"channel reply error: {exc}")
        return
    import connectorlib
    connector_id = info.get("connector", "")
    try:
        outcome = connectorlib.send_message(connector_id, reply)
        if not outcome.get("ok"):
            log(f"connector {connector_id} reply failed: "
                f"{outcome.get('error')}")
    except ValueError as exc:
        log(f"connector reply error: {exc}")


def _flush_pending_replies():
    pending = _load_pending()
    if not pending:
        return
    changed = False
    for task_id in list(pending):
        try:
            task = agentlib.load_task(task_id)
        except (OSError, ValueError):
            pending.pop(task_id, None)
            changed = True
            continue
        if task.get("status") not in ("done", "failed", "cancelled"):
            continue
        info = pending.pop(task_id)
        changed = True
        reply = ""
        if task.get("status") == "done":
            reply = str((task.get("result") or {}).get("reply") or "")
        if reply:
            _deliver_reply(info, reply)
        else:
            agentlib.log_event(
                "system",
                f"inbound task {task_id} finished without a reply; "
                "nothing sent (no fabricated text)",
                session=task.get("session", ""))
    if changed:
        _save_pending(pending)


def serve_forever():
    lock_path = "/var/lib/dclawos/agent.lock"
    try:
        agentlib.ensure_exchange_dir("/var/lib/dclawos")
        lock_file = open(lock_path, "a", encoding="utf-8")
        fcntl.flock(lock_file, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except (OSError, BlockingIOError):
        log("another dclawos-agent is already running; exiting")
        return 1
    # Phase 6 M1: the daemon owns the event bus, and the task queue
    # is woken by PUSH — inotify on the tasks directory plus task
    # events arriving on the bus — not by a timed queue scan.
    import select as _select
    import eventbus
    wake_r, wake_w = os.pipe()
    os.set_blocking(wake_r, False)
    os.set_blocking(wake_w, False)

    def _wake():
        try:
            os.write(wake_w, b"\x01")
        except OSError:
            pass

    def _on_bus_event(event):
        if event.get("type") == "task":
            _wake()

    bus_server = None
    try:
        bus_server = eventbus.EventBusServer(
            on_event=_on_bus_event).start()
    except OSError as exc:
        log(f"event bus unavailable (continuing): {exc}")
    watcher = None
    try:
        agentlib.ensure_exchange_dir(agentlib.tasks_dir())
        watcher = eventbus.DirectoryWatcher(agentlib.tasks_dir())
    except OSError as exc:
        # Documented fallback: with no inotify, the wait below
        # times out every TASK_FALLBACK_SECONDS and the loop
        # rescans — slower, never stuck.
        log(f"inotify unavailable, fallback scan only: {exc}")
    log("dclawos-agent serving (event-driven task queue)")
    # Phase 4 module 5: bounded concurrency. Up to MAX_PARALLEL
    # tasks run at once (a parent waiting on an inline subagent no
    # longer blocks unrelated tasks); approvals/events use atomic
    # file writes, and each task touches only its own task file.
    from concurrent.futures import ThreadPoolExecutor
    executor = ThreadPoolExecutor(max_workers=MAX_PARALLEL)
    in_flight = {}

    def _collect_done():
        for tid in [t for t, f in in_flight.items() if f.done()]:
            future = in_flight.pop(tid)
            try:
                future.result()
            except Exception as exc:  # noqa: BLE001 - logged, not fatal
                log(f"task {tid} crashed: {exc}")

    next_connector_at = 0.0
    while True:
        try:
            _collect_done()
            try:
                import cronlib
                cronlib.fire_due()
            except Exception as exc:  # noqa: BLE001 - cron is additive
                log(f"cron fire error (continuing): {exc}")
            try:
                _flush_pending_replies()
                if time.time() >= next_connector_at:
                    next_connector_at = time.time() \
                        + CONNECTOR_CYCLE_SECONDS
                    _poll_connectors()
                    _poll_channels()
            except Exception as exc:  # noqa: BLE001 - inbound is additive
                log(f"connector inbound error (continuing): {exc}")
            if len(in_flight) < MAX_PARALLEL:
                task = agentlib.next_queued_task()
                if task is not None and task["id"] not in in_flight:
                    task["status"] = "running"
                    agentlib.save_task(task)
                    in_flight[task["id"]] = executor.submit(
                        run_task, task)
                    continue
            # Wait for a push wake-up: a bus task event (self-pipe),
            # a tasks-directory change (inotify), a task finishing
            # soon (short wait while work is in flight so done
            # futures are collected), the next periodic connector
            # cycle, or — the documented safety fallback — the
            # fallback bound, whichever comes first.
            if in_flight:
                wait = 1.0
            else:
                wait = max(0.05, min(
                    TASK_FALLBACK_SECONDS,
                    next_connector_at - time.time()))
            fds = [wake_r]
            if watcher is not None:
                fds.append(watcher.fileno())
            try:
                ready, _w, _x = _select.select(fds, [], [], wait)
            except (OSError, ValueError):
                ready = []
            for fd in ready:
                if fd == wake_r:
                    try:
                        os.read(wake_r, 4096)
                    except OSError:
                        pass
                elif watcher is not None and fd == watcher.fileno():
                    watcher.drain()
        except KeyboardInterrupt:
            log("dclawos-agent stopping")
            executor.shutdown(wait=False)
            if bus_server is not None:
                bus_server.stop()
            return 0
        except Exception as exc:  # noqa: BLE001 - daemon must not die
            log(f"loop error (continuing): {exc}")
            time.sleep(1)


def main():
    parser = argparse.ArgumentParser(prog="dclawos-agent")
    parser.add_argument("--once", action="store_true",
                        help="run one queued task, then exit")
    args = parser.parse_args()
    if args.once:
        task = agentlib.next_queued_task()
        if task is None:
            print(json.dumps({"ran": False}))
            return 0
        result = run_task(task)
        print(json.dumps({"ran": True, "task": result["id"],
                          "status": result["status"]}))
        return 0
    return serve_forever()


if __name__ == "__main__":
    sys.exit(main())
