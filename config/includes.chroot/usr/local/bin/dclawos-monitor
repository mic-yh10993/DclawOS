#!/usr/bin/env python3
"""DclawOS AI monitor (Phase 2 module 7; Phase 6 M5: GTK4 +
libadwaita — Adw.init, Gtk 4.0 window, GTK4 dialog/main-loop
idioms via run_dialog/run_window; functions unchanged).

Shows the AI user's processes and gives the human the intervention
controls (user-confirmed Q1: monitor AND intervene/stop both):
- "叫停 AI": sets the cooperative stop flag (dclawos-agent-ctl stop).
  The agent service (Phase 3+) checks the flag before each action
  and step, so a set flag stops new work at the next check.
- "恢复 AI": clears the flag.
- "强制结束 agent 进程": sudo pkill -u dclaw-agent, with a confirmation
  dialog. This one is immediate regardless of any service.
The event stream itself lives on the AI dashboard; this window is for
processes + stop controls only. Process listing via ps needs no sudo
(read-only); the kill needs the live session's NOPASSWD sudo.

Phase 6 M1 (push): freshness is event-driven. The process/stop
snapshot is loaded ONCE at startup; after that the window refreshes
only when a relevant event arrives on the event bus (task, system,
approval, settings, takeover, stop, command, output, agent events —
the things that can change the agent's process/stop state) or when
the human presses a button. There is no display timer. Bus events
arrive on a subscriber thread and are marshalled with
GLib.idle_add (the repo's GTK pattern; the subscriber itself is
eventbus.EventSubscriber).
"""

import os
import subprocess
import sys

import gi  # noqa: E402

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gtk, GLib  # noqa: E402

sys.path.insert(0, "/usr/local/lib/dclawos")
sys.path.insert(0, os.path.join(
    os.path.dirname(os.path.abspath(__file__)), "..", "lib", "dclawos"))
try:
    import eventbus
except ImportError:
    eventbus = None

CTL = "dclawos-agent-ctl"
STOP_FLAG = "/var/lib/dclawos/agent-stop.json"
AGENT_USER = "dclaw-agent"
REFRESH_EVENT_TYPES = frozenset({
    "task", "system", "approval", "settings", "takeover", "stop",
    "command", "output", "agent", "process",
})


def log(msg):
    print(f"dclawos-monitor: {msg}", flush=True)


def ctl(*argv):
    try:
        proc = subprocess.run(
            [CTL] + list(argv),
            capture_output=True, text=True, timeout=15)
    except (FileNotFoundError, subprocess.TimeoutExpired) as exc:
        return 1, "", str(exc)
    return proc.returncode, proc.stdout, proc.stderr



def _append_expand(box, child, expand=False):
    """GTK4 Box packing (pack_start/pack_end were removed): append
    (or prepend) and translate the old expand flag onto the child's
    expand property along the box orientation.
    // reuse-check: GTK4 migration idiom written for DclawOS; the
      helper exists so every pre-GTK4 pack call site keeps its
      expand semantics with the child evaluated exactly once."""
    box.append(child)
    if expand:
        if box.get_orientation() == Gtk.Orientation.VERTICAL:
            child.set_vexpand(True)
        else:
            child.set_hexpand(True)
    return child


def _prepend_expand(box, child, expand=False):
    box.prepend(child)
    if expand:
        if box.get_orientation() == Gtk.Orientation.VERTICAL:
            child.set_vexpand(True)
        else:
            child.set_hexpand(True)
    return child


def run_dialog(dialog):
    """GTK4 replacement for Gtk.Dialog.run() (removed in GTK4):
    present the dialog and run a nested GLib main loop until the
    dialog emits "response" (or is closed), then return the
    response id. Callers keep their synchronous shape; the dialog
    itself is a real GTK4 Dialog/FileChooser/MessageDialog.
    // reuse-check: pattern is the GTK4 migration guide's own
      response-signal idiom, adapted to a nested MainLoop so the
      pre-GTK4 call sites keep their control flow unchanged."""
    loop = GLib.MainLoop()
    holder = {"response": Gtk.ResponseType.CANCEL}

    def _on_response(_dialog, response):
        holder["response"] = response
        loop.quit()

    def _on_close(_dialog):
        loop.quit()
        return False

    dialog.connect("response", _on_response)
    dialog.connect("close-request", _on_close)
    dialog.present()
    loop.run()
    return holder["response"]


def run_window(window):
    """GTK4 main loop for a top-level window (Gtk.main() and the
    "destroy" signal were removed in GTK4): present the window and
    run a GLib main loop until it emits "close-request"."""
    loop = GLib.MainLoop()

    def _on_close(_window):
        loop.quit()
        return False

    window.connect("close-request", _on_close)
    window.present()
    loop.run()
    return 0

class MonitorApp(Gtk.Window):
    def __init__(self):
        super().__init__(title="dclawos-monitor")
        self.set_default_size(800, 500)
        try:
            import theme
            theme.apply_theme()
        except ImportError:
            pass
        header = Gtk.HeaderBar()
        _title_box = Gtk.Box(
            orientation=Gtk.Orientation.VERTICAL, spacing=0)
        _title_label = Gtk.Label(label="监视 AI")
        _title_label.add_css_class("heading")
        _title_box.append(_title_label)
        _subtitle_label = Gtk.Label(label="进程状态与叫停")
        _subtitle_label.add_css_class("dim-label")
        _title_box.append(_subtitle_label)
        header.set_title_widget(_title_box)
        self.set_titlebar(header)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        box.set_margin_top(8)
        box.set_margin_bottom(8)
        box.set_margin_start(8)
        box.set_margin_end(8)
        self.set_child(box)

        header = Gtk.Label(label="AI 监视 — agent 进程与叫停")
        header.set_halign(Gtk.Align.START)
        _append_expand(box, header, False)

        self.status = Gtk.Label(label="")
        self.status.set_halign(Gtk.Align.START)
        try:
            import theme
            theme.apply_tnum(self.status)
        except Exception:
            pass
        _append_expand(box, self.status, False)

        buttons = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        btn_stop = Gtk.Button(label="叫停 AI（设置停止标志）")
        btn_stop.connect("clicked", self.on_stop)
        btn_resume = Gtk.Button(label="恢复 AI（清除标志）")
        btn_resume.connect("clicked", self.on_resume)
        btn_kill = Gtk.Button(label="强制结束 agent 进程")
        btn_kill.connect("clicked", self.on_kill)
        for btn in (btn_stop, btn_resume, btn_kill):
            _append_expand(buttons, btn, False)
        _append_expand(box, buttons, False)

        note = Gtk.Label(
            label="说明：叫停标志是协作式停止，agent 服务在每个动作前"
                  "检查该标志；强制结束立即终止所有 agent 进程。"
                  "事件流请看 AI 看板。")
        note.set_wrap(True)
        note.set_halign(Gtk.Align.START)
        try:
            import theme
            theme.apply_prose(note)
        except Exception:
            pass
        _append_expand(box, note, False)

        self.store = Gtk.ListStore(str, str, str)
        tree = Gtk.TreeView(model=self.store)
        for index, title in enumerate(("PID", "运行时长", "命令")):
            column = Gtk.TreeViewColumn(
                title, Gtk.CellRendererText(), text=index)
            column.set_resizable(True)
            if index == 2:
                column.set_expand(True)
            tree.append_column(column)
        scrolled = Gtk.ScrolledWindow()
        scrolled.set_child(tree)
        _append_expand(box, scrolled, True)

        self.refresh()
        self.subscriber = None
        if eventbus is not None:
            self.subscriber = eventbus.EventSubscriber(
                self._on_bus_event_thread)
            self.subscriber.start()

    def _on_bus_event_thread(self, event):
        # Subscriber thread: marshal into the GTK main loop, and
        # only for event types that can change what this window
        # shows (process list / stop state).
        if isinstance(event, dict) and \
                event.get("type") in REFRESH_EVENT_TYPES:
            GLib.idle_add(self.refresh_from_bus)

    def refresh_from_bus(self):
        self.refresh()
        return False

    def read_flag(self):
        flag_path = os.environ.get("DCLAWOS_STOP_FLAG", STOP_FLAG)
        try:
            import json
            with open(flag_path, "r", encoding="utf-8") as handle:
                return json.load(handle)
        except (OSError, ValueError):
            return None

    def refresh(self):
        flag = self.read_flag()
        if flag is not None:
            self.status.set_text(
                "AI 状态：已叫停（停止标志已设置，agent 将不再执行新操作）"
                f" — 原因：{flag.get('reason', '')}")
        else:
            self.status.set_text("AI 状态：运行中（无停止标志）")
        try:
            proc = subprocess.run(
                ["ps", "-u", AGENT_USER, "-o", "pid=,etime=,cmd=",
                 "--no-headers"],
                capture_output=True, text=True, timeout=5)
            lines = [ln for ln in proc.stdout.splitlines() if ln.strip()]
        except (FileNotFoundError, subprocess.TimeoutExpired):
            lines = []
        self.store.clear()
        if not lines:
            self.store.append(("--", "--", "agent 未运行（无 agent 进程）"))
        else:
            for line in lines:
                parts = line.strip().split(None, 2)
                if len(parts) == 3:
                    self.store.append((parts[0], parts[1], parts[2]))
        return True

    def on_stop(self, _button):
        rc, _out, err = ctl("stop", "--reason", "human monitor stop")
        if rc != 0:
            self.status.set_text(f"叫停失败：{err.strip()}")
        self.refresh()

    def on_resume(self, _button):
        rc, _out, err = ctl("resume")
        if rc != 0:
            self.status.set_text(f"恢复失败：{err.strip()}")
        self.refresh()

    def on_kill(self, _button):
        dialog = Gtk.MessageDialog(
            transient_for=self,
            message_type=Gtk.MessageType.QUESTION,
            buttons=Gtk.ButtonsType.OK_CANCEL,
            text="确定要强制结束所有 agent 进程吗？")
        dialog.format_secondary_text(
            "未保存的 agent 工作将丢失。此操作立即生效。")
        response = run_dialog(dialog)
        dialog.destroy()
        if response != Gtk.ResponseType.OK:
            return
        rc, out, err = ctl("kill")
        if rc != 0:
            self.status.set_text(f"强制结束失败：{err.strip()}")
        else:
            log(f"kill result: {out.strip()}")
        self.refresh()


def main():
    if len(sys.argv) > 1 and sys.argv[1] in ("-h", "--help"):
        print("usage: dclawos-monitor (AI process monitor + stop controls)")
        return 0
    Adw.init()
    return run_window(MonitorApp())


if __name__ == "__main__":
    sys.exit(main())
