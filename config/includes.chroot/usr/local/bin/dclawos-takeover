#!/usr/bin/env python3
"""DclawOS human-takeover popup (Phase 2 module 6; Phase 6 M5:
GTK4 + libadwaita migration — window/dialog idioms only, the Q2
backfill semantics in the docstring below are unchanged).

Shows takeover requests (see takeoverlib.py) and lets the human resolve
them. The human completes the step (captcha, login, verification) in
their OWN session — this popup only records the OUTCOME. It has no
password field: the session-handle entry is a plain visible text field
labeled "do not enter passwords or tokens", and the backfill never
contains credentials (takeoverlib.write_result drops credential-like
extra keys). The popup logs request id + outcome only — never the
session handle.
"""

import os
import sys
import time

sys.path.insert(0, "/usr/local/lib/dclawos")
sys.path.insert(0, os.path.join(
    os.path.dirname(os.path.abspath(__file__)), "..", "lib", "dclawos"))

import gi  # noqa: E402

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gtk, GLib  # noqa: E402

try:
    import takeoverlib
except ImportError as exc:
    print(f"dclawos-takeover: takeover store unavailable: {exc}",
          file=sys.stderr)
    sys.exit(1)

POLL_MS = 1000
KIND_LABELS = {
    "captcha": "人机验证",
    "login": "登录账号",
    "verification": "验证",
    "other": "其他",
}


def log(msg):
    print(f"dclawos-takeover: {msg}", flush=True)



def _append_expand(box, child, expand=False):
    """GTK4 Box packing (pack_start/pack_end were removed): append
    (or prepend) and translate the old expand flag onto the child's
    expand property along the box orientation.
    // reuse-check: GTK4 migration idiom written for DclawOS; the
      helper exists so every pre-GTK4 pack call site keeps its
      expand semantics with the child evaluated exactly once."""
    box.append(child)
    if expand:
        if box.get_orientation() == Gtk.Orientation.VERTICAL:
            child.set_vexpand(True)
        else:
            child.set_hexpand(True)
    return child


def _prepend_expand(box, child, expand=False):
    box.prepend(child)
    if expand:
        if box.get_orientation() == Gtk.Orientation.VERTICAL:
            child.set_vexpand(True)
        else:
            child.set_hexpand(True)
    return child


def run_dialog(dialog):
    """GTK4 replacement for Gtk.Dialog.run() (removed in GTK4):
    present the dialog and run a nested GLib main loop until the
    dialog emits "response" (or is closed), then return the
    response id. Callers keep their synchronous shape; the dialog
    itself is a real GTK4 Dialog/FileChooser/MessageDialog.
    // reuse-check: pattern is the GTK4 migration guide's own
      response-signal idiom, adapted to a nested MainLoop so the
      pre-GTK4 call sites keep their control flow unchanged."""
    loop = GLib.MainLoop()
    holder = {"response": Gtk.ResponseType.CANCEL}

    def _on_response(_dialog, response):
        holder["response"] = response
        loop.quit()

    def _on_close(_dialog):
        loop.quit()
        return False

    dialog.connect("response", _on_response)
    dialog.connect("close-request", _on_close)
    dialog.present()
    loop.run()
    return holder["response"]


def run_window(window):
    """GTK4 main loop for a top-level window (Gtk.main() and the
    "destroy" signal were removed in GTK4): present the window and
    run a GLib main loop until it emits "close-request"."""
    loop = GLib.MainLoop()

    def _on_close(_window):
        loop.quit()
        return False

    window.connect("close-request", _on_close)
    window.present()
    loop.run()
    return 0

class TakeoverApp(Gtk.Window):
    def __init__(self):
        super().__init__(title="dclawos-takeover")
        self.set_default_size(700, 500)
        try:
            import theme
            theme.apply_theme()
        except ImportError:
            pass
        header = Gtk.HeaderBar()
        _title_box = Gtk.Box(
            orientation=Gtk.Orientation.VERTICAL, spacing=0)
        _title_label = Gtk.Label(label="人工接管")
        _title_label.add_css_class("heading")
        _title_box.append(_title_label)
        _subtitle_label = Gtk.Label(label="AI 请求你接管")
        _subtitle_label.add_css_class("dim-label")
        _title_box.append(_subtitle_label)
        header.set_title_widget(_title_box)
        self.set_titlebar(header)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        box.set_margin_top(8)
        box.set_margin_bottom(8)
        box.set_margin_start(8)
        box.set_margin_end(8)
        self.set_child(box)

        header = Gtk.Label(
            label="AI 接管请求 — AI 需要你帮忙完成一步操作")
        header.set_halign(Gtk.Align.START)
        _append_expand(box, header, False)

        note = Gtk.Label(
            label="说明：请先在你自己的会话里完成验证/登录，再回来点"
                  "按钮。这里只记录成功/失败与会话标识，绝不要在这里"
                  "输入密码、验证码或令牌。")
        note.set_wrap(True)
        note.set_halign(Gtk.Align.START)
        _append_expand(box, note, False)

        self.store = Gtk.ListStore(str, str, str, str, str)
        tree = Gtk.TreeView(model=self.store)
        for index, title in enumerate(("种类", "请求内容", "状态", "时间")):
            column = Gtk.TreeViewColumn(
                title, Gtk.CellRendererText(), text=index)
            column.set_resizable(True)
            if index == 1:
                column.set_expand(True)
            tree.append_column(column)
        tree.get_selection().connect("changed", self.on_select)
        self.tree = tree
        scrolled = Gtk.ScrolledWindow()
        scrolled.set_child(tree)
        _append_expand(box, scrolled, True)

        self.detail = Gtk.Label(label="请选择一条待处理请求")
        self.detail.set_wrap(True)
        self.detail.set_halign(Gtk.Align.START)
        _append_expand(box, self.detail, False)

        self.handle_entry = Gtk.Entry()
        self.handle_entry.set_placeholder_text(
            "会话标识（可选，如已登录账号名；不要填密码/令牌）")
        _append_expand(box, self.handle_entry, False)

        buttons = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        self.btn_done = Gtk.Button(label="我已完成（成功）")
        self.btn_done.connect("clicked", self.on_resolve, "success")
        self.btn_fail = Gtk.Button(label="失败")
        self.btn_fail.connect("clicked", self.on_resolve, "fail")
        self.btn_cancel = Gtk.Button(label="取消请求")
        self.btn_cancel.connect("clicked", self.on_resolve, "cancelled")
        for btn in (self.btn_done, self.btn_fail, self.btn_cancel):
            _append_expand(buttons, btn, False)
        _append_expand(box, buttons, False)

        self.selected_id = None
        self.set_actions_sensitive(False)
        self.refresh()
        GLib.timeout_add(POLL_MS, self.refresh)

    def set_actions_sensitive(self, sensitive):
        for btn in (self.btn_done, self.btn_fail, self.btn_cancel):
            btn.set_sensitive(sensitive)

    def on_select(self, selection):
        model, tree_iter = selection.get_selected()
        if tree_iter is None:
            self.selected_id = None
            self.set_actions_sensitive(False)
            self.detail.set_text("请选择一条待处理请求")
            return
        # The request id travels in the store's hidden 5th column, so
        # the selection stays correct across refreshes.
        self.selected_id = model[tree_iter][4]
        request = None
        for candidate in takeoverlib.list_requests():
            if candidate["id"] == self.selected_id:
                request = candidate
                break
        if request is None:
            self.selected_id = None
            self.set_actions_sensitive(False)
            return
        pending = request.get("status") == "pending"
        self.set_actions_sensitive(pending)
        when = time.strftime(
            "%Y-%m-%d %H:%M:%S",
            time.localtime(int(request.get("created_at", 0))))
        self.detail.set_text(
            f"种类：{KIND_LABELS.get(request.get('kind'), request.get('kind'))}\n"
            f"内容：{request.get('message')}\n"
            f"应用提示：{request.get('app_hint') or '无'}\n"
            f"创建时间：{when}\n"
            f"状态：{request.get('status')}")

    def on_resolve(self, _button, outcome):
        if not self.selected_id:
            return
        handle = self.handle_entry.get_text().strip() or None
        try:
            takeoverlib.write_result(self.selected_id, outcome, handle)
        except (ValueError, OSError) as exc:
            self.detail.set_text(f"回填失败：{exc}")
            return
        log(f"resolved id={self.selected_id} outcome={outcome}")
        self.handle_entry.set_text("")
        self.selected_id = None
        self.set_actions_sensitive(False)
        self.refresh()

    def refresh(self):
        requests = takeoverlib.list_requests()
        # Newest first; pending rows first within the same view.
        requests.sort(key=lambda r: (
            r.get("status") != "pending", -(r.get("created_at", 0))))
        self.store.clear()
        for request in requests:
            when = time.strftime(
                "%H:%M:%S",
                time.localtime(int(request.get("created_at", 0))))
            self.store.append((
                KIND_LABELS.get(request.get("kind"), request.get("kind")),
                str(request.get("message", "")),
                str(request.get("status", "")),
                when,
                str(request.get("id", ""))))
        return True


def main():
    if len(sys.argv) > 1 and sys.argv[1] in ("-h", "--help"):
        print("usage: dclawos-takeover (human popup for AI takeover "
              "requests)")
        return 0
    Adw.init()
    return run_window(TakeoverApp())


if __name__ == "__main__":
    sys.exit(main())
