#!/usr/bin/env python3
"""DclawOS GUI operation CLI (Phase 2 module 6): the AI's hands.

Lets the agent service list, focus and drive GUI windows in the live
X session. These are SESSION-USER actions (visible on screen to the
human, watched by module 7 monitoring) — they are NOT privileged ops
and do NOT go through the broker; privileged ops still need tickets.

  dclawos-gui windows
  dclawos-gui activate --title '设置' | --id <xid>
  dclawos-gui key --keys 'ctrl+l' [--window <xid>]
  dclawos-gui click --x 100 --y 200 [--button 1]
  dclawos-gui type --text 'hello'

Windows/activation use Wnck (the same compositor library the taskbar
uses); key/click/type shell out to xdotool (Debian package, no shell,
arguments validated). Without an X session the tool fails cleanly with
a message instead of a traceback.
"""

import argparse
import json
import re
import subprocess
import sys

KEY_PART_RE = re.compile(r"^[A-Za-z0-9_]+$")


def fail(message):
    print(f"dclawos-gui: {message}", file=sys.stderr)
    return 1


def wnck_screen():
    try:
        import gi
        gi.require_version("Wnck", "3.0")
        from gi.repository import Wnck
    except (ImportError, ValueError) as exc:
        raise RuntimeError(f"Wnck unavailable (need an X session): {exc}")
    screen = Wnck.Screen.get_default()
    if screen is None:
        raise RuntimeError("no Wnck screen (is DISPLAY set? is X running?)")
    screen.force_update()
    return Wnck, screen


def cmd_windows(_args):
    try:
        _Wnck, screen = wnck_screen()
    except RuntimeError as exc:
        return fail(str(exc))
    windows = []
    for window in screen.get_windows():
        app = window.get_application()
        windows.append({
            "id": window.get_xid(),
            "title": window.get_name(),
            "app": app.get_name() if app is not None else None,
            "active": window.is_active(),
        })
    print(json.dumps(windows, indent=2, ensure_ascii=False))
    return 0


def cmd_activate(args):
    if bool(args.title) == bool(args.id):
        return fail("activate needs exactly one of --title or --id")
    try:
        _Wnck, screen = wnck_screen()
    except RuntimeError as exc:
        return fail(str(exc))
    target = None
    for window in screen.get_windows():
        if args.id is not None and window.get_xid() == args.id:
            target = window
            break
        if args.title is not None \
                and args.title.lower() in (window.get_name() or "").lower():
            target = window
            break
    if target is None:
        return fail("no matching window")
    target.activate(0)
    print(json.dumps({"activated": target.get_xid(),
                      "title": target.get_name()}, ensure_ascii=False))
    return 0


def run_xdotool(argv):
    try:
        proc = subprocess.run(
            ["xdotool"] + argv,
            capture_output=True, text=True, timeout=30)
    except FileNotFoundError:
        return fail("xdotool not installed")
    except subprocess.TimeoutExpired:
        return fail("xdotool timed out")
    if proc.returncode != 0:
        return fail(f"xdotool failed ({proc.returncode}): "
                    f"{proc.stderr.strip()}")
    if proc.stdout.strip():
        print(proc.stdout.strip())
    return 0


def cmd_key(args):
    parts = args.keys.split("+")
    if not parts or any(not KEY_PART_RE.match(p) for p in parts):
        return fail(f"invalid --keys: {args.keys!r} "
                    "(letters, digits, underscore, joined by +)")
    argv = []
    if args.window is not None:
        argv += ["key", "--window", str(args.window), args.keys]
    else:
        argv += ["key", args.keys]
    return run_xdotool(argv)


def cmd_click(args):
    if args.x < 0 or args.y < 0:
        return fail("click coordinates must be >= 0")
    if args.button not in (1, 2, 3):
        return fail("click --button must be 1, 2 or 3")
    return run_xdotool(["mousemove", str(args.x), str(args.y),
                        "click", str(args.button)])


def cmd_type(args):
    return run_xdotool(["type", "--clearmodifiers", "--", args.text])


def main():
    parser = argparse.ArgumentParser(prog="dclawos-gui")
    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("windows", help="list windows as JSON")
    p.set_defaults(func=cmd_windows)

    p = sub.add_parser("activate", help="focus a window")
    p.add_argument("--title", default=None)
    p.add_argument("--id", type=int, default=None)
    p.set_defaults(func=cmd_activate)

    p = sub.add_parser("key", help="send a keystroke (xdotool key)")
    p.add_argument("--keys", required=True)
    p.add_argument("--window", type=int, default=None)
    p.set_defaults(func=cmd_key)

    p = sub.add_parser("click", help="move + click (xdotool)")
    p.add_argument("--x", type=int, required=True)
    p.add_argument("--y", type=int, required=True)
    p.add_argument("--button", type=int, default=1)
    p.set_defaults(func=cmd_click)

    p = sub.add_parser("type", help="type text (xdotool type)")
    p.add_argument("--text", required=True)
    p.set_defaults(func=cmd_type)

    args = parser.parse_args()
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
