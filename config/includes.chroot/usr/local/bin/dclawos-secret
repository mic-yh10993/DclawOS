#!/usr/bin/env python3
"""DclawOS secret admin CLI (Phase 3 module 1): store agent secrets.

Usage: dclawos-secret set <name>
Reads the value from stdin (piped) or, on a tty, with echo disabled.
Flow: create a write-secret ticket -> wait for human approval in
dclawos-approve (or full-access auto-approval) -> broker writes
/var/lib/dclawos/secrets/<name> owned by dclaw-agent 0600.

Deliberately set-only: there is no get path. The agent service reads
its own secret files directly; the value is never printed, never
logged, and never stored in a ticket file (tickets hold only the
params hash + summary).
"""

import getpass
import json
import os
import socket
import sys

sys.path.insert(0, "/usr/local/lib/dclawos")
sys.path.insert(0, os.path.join(
    os.path.dirname(os.path.abspath(__file__)), "..", "lib", "dclawos"))

import agentlib  # noqa: E402
import ticketlib  # noqa: E402


def broker_execute(ticket_id, operation, params):
    request = json.dumps({"ticket_id": ticket_id, "operation": operation,
                          "params": params}) + "\n"
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        sock.settimeout(60)
        sock.connect(ticketlib.socket_path())
        sock.sendall(request.encode("utf-8"))
        data = b""
        while not data.endswith(b"\n"):
            chunk = sock.recv(65536)
            if not chunk:
                break
            data += chunk
    finally:
        sock.close()
    try:
        return json.loads(data.decode("utf-8"))
    except (ValueError, UnicodeDecodeError):
        return {"ok": False, "error": "broker reply not valid JSON"}


def main():
    if len(sys.argv) != 3 or sys.argv[1] != "set":
        print("usage: dclawos-secret set <name>", file=sys.stderr)
        return 2
    name = sys.argv[2]
    if sys.stdin.isatty():
        value = getpass.getpass("secret value (not echoed): ")
    else:
        value = sys.stdin.read()
    value = value.strip("\n")
    if not value:
        print("dclawos-secret: empty value refused", file=sys.stderr)
        return 1
    params = {"name": name, "value": value}
    # The value itself is never printed or logged from here on.
    verdict, ticket_id = agentlib.request_approval(
        "write-secret", params, f"store secret {name}")
    if verdict != "approved":
        print(f"dclawos-secret: approval {verdict}; secret not stored",
              file=sys.stderr)
        return 1
    reply = broker_execute(ticket_id, "write-secret", params)
    if not reply.get("ok"):
        print(f"dclawos-secret: broker refused: {reply.get('error')}",
              file=sys.stderr)
        return 1
    print(json.dumps({"stored": True, "name": name}))
    return 0


if __name__ == "__main__":
    sys.exit(main())
