xauth
x11-xserver-utils
x11-utils
dbus-x11
policykit-1
lightdm
lightdm-gtk-greeter
openbox
python3
python3-gi
gir1.2-gtk-3.0
gir1.2-wnck-3.0
libglib2.0-bin
upower
fonts-wqy-zenhei
xterm
xdotool
