#!/bin/sh
# DclawOS agent-loop behavior gate (Phase 4 module 2). Hard-fails:
# the LLM loop must prove itself inside the image before the ISO
# can go green. Runs the real agent daemon against a local mock
# OpenAI-compatible endpoint (dummy key, no external network):
# tool-call round trip, transcript persistence, cost accounting
# from mock usage, and the honest model-less path.
set -eu

[ -f /usr/local/lib/dclawos/agentlooptest.py ] || {
    echo "dclawos-looptest: test script missing" >&2
    exit 1
}
[ -s /usr/share/dclawos/engine/llm.js ] || {
    echo "dclawos-looptest: llm engine bundle missing (hook 1003)" >&2
    exit 1
}
python3 /usr/local/lib/dclawos/agentlooptest.py

# Phase 5 module 1: channel runtime behavior gate. Same pattern:
# real channellib + Telegram adapter + daemon poll/flush against a
# local mock Bot API server (dummy token, no external network):
# allowlist filtering, cursor once-only delivery, reply routing.
[ -f /usr/local/lib/dclawos/channeltest.py ] || {
    echo "dclawos-chantest: test script missing" >&2
    exit 1
}
python3 /usr/local/lib/dclawos/channeltest.py

# Phase 5 module 4: self-provisioning behavior gate. provisioninglib
# against local fixtures only: skill install/remove with rollback,
# MCP handshake-gated add over stdio AND streamable HTTP (mock
# servers), channel management, registry env redaction, tiers.
[ -f /usr/local/lib/dclawos/provisiontest.py ] || {
    echo "dclawos-provtest: test script missing" >&2
    exit 1
}
python3 /usr/local/lib/dclawos/provisiontest.py

# Phase 5 follow-up (P5-M7): shared settings store gate. settingslib
# round trips (daemon-side write -> GUI-side read via the same lib),
# the settings_set denylist, validation, corrupt-file fallback, and
# — required here, since the chroot has both users — the two-user
# permission simulation (dclaw-agent <-> dclaw, nobody locked out).
[ -f /usr/local/lib/dclawos/settingstest.py ] || {
    echo "dclawos-settingstest: test script missing" >&2
    exit 1
}
DCLAWOS_SETTINGSTEST_REQUIRE_SIM=1 \
    python3 /usr/local/lib/dclawos/settingstest.py

# Phase 6 module M1: event bus + bridge protocol + live output gate.
# eventbus server on a temp socket (subscriber delivery, durable log
# still written, malformed input survives), bridgeprotocol
# allowlist/secret rules, LIVE _run_shell chunk streaming from the
# real daemon code, and the task wake path (save_task bus signal +
# inotify watcher).
[ -f /usr/local/lib/dclawos/eventbustest.py ] || {
    echo "dclawos-eventbustest: test script missing" >&2
    exit 1
}
python3 /usr/local/lib/dclawos/eventbustest.py

# Phase 6 module M2: model settings wiring gate. registrylib model
# validation, CRUD -> llmlib request assembly, pin selection order,
# full routing pass-through (fake dclawos-llm capturing the request
# JSON + a local mock OpenAI-compatible endpoint), connectivity
# success/failure/no-key, usage ledger aggregation (null cost kept
# separate), bridge allowlist for the model.* verbs, and health
# status tolerance for missing/corrupt engine state files.
[ -f /usr/local/lib/dclawos/modeltest.py ] || {
    echo "dclawos-modeltest: test script missing" >&2
    exit 1
}
python3 /usr/local/lib/dclawos/modeltest.py

# Phase 6 module M3: chat WebView + true-streaming gate. chattest
# runs the REAL dclawos-llm --stream against a local mock SSE
# server (first delta before completion, assembly, usage, sse vs
# staged labelling, pre-delta failure, no-key honesty), the daemon
# streaming wiring over the event bus + usage ledger, the chat
# host approval verdict/redaction path, and parse_command fidelity.
[ -f /usr/local/lib/dclawos/chattest.py ] || {
    echo "dclawos-chattest: test script missing" >&2
    exit 1
}
python3 /usr/local/lib/dclawos/chattest.py

# Phase 6 module M4: dashboard WebView + taskbar state gate.
# dashboardlib snapshot construction (counts, null-cost split,
# snapshot/live dedupe by event id), the shell four-state reducer
# transitions, the approval overlay payload redaction + the
# shared verdict write fields, and pending-count seeding with
# event-only increments — all against temp-dir fixtures.
[ -f /usr/local/lib/dclawos/dashboardtest.py ] || {
    echo "dclawos-dashboardtest: test script missing" >&2
    exit 1
}
python3 /usr/local/lib/dclawos/dashboardtest.py
