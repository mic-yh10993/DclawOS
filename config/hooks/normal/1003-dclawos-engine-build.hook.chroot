#!/bin/sh
# DclawOS routing engine build (Phase 2 module 4). Hard-fails: if the
# engine cannot be compiled, the image must not go green silently.
#
# Why this shape (see engine-src/README.md for the full strip story):
# - The engine source (497 files, MIT) ships in the image under
#   /usr/share/dclawos/engine-src/ and is compiled on EVERY build
#   (Q4: "随映像编译", not a prebuilt blob).
# - Upstream engines require Node >=22.22.2 <23 || >=24 <27; Debian
#   bookworm ships Node 18, too old for compile AND runtime. So this hook
#   installs the official Node 24 LTS tarball to /opt/dclawos-node (kept
#   as the image's agent-service runtime) and symlinks it as dclawos-node.
# - esbuild bundles the subset (resolving the @/ and @omniroute/open-sse
#   path aliases) into one CJS file; runtime deps (zod, undici, ws,
#   socks, yazl, safe-regex) are bundled, so no node_modules ships.
# - Versions are pinned to the upstream lockfile (esbuild 0.28.2,
#   zod 4.6.7, undici 8.12.3, ws 8.21.3, socks 2.8.9, yazl 3.3.1,
#   safe-regex 2.1.1) for reproducible builds.
set -eu

ENGINE_SRC=/usr/share/dclawos/engine-src
ENGINE_OUT=/usr/share/dclawos/engine
NODE_VERSION=v24.22.2
NODE_DIR=/opt/dclawos-node
STAGE=/tmp/dclawos-engine-build

[ -d "$ENGINE_SRC/src" ] && [ -d "$ENGINE_SRC/open-sse" ] || {
    echo "dclawos-engine: missing engine source tree: $ENGINE_SRC" >&2
    exit 1
}
[ -f "$ENGINE_SRC/dclawos/decision.ts" ] || {
    echo "dclawos-engine: missing decision entry: $ENGINE_SRC/dclawos/decision.ts" >&2
    exit 1
}

# 1. Node 24 runtime (kept in the image for the agent service).
if [ ! -x "$NODE_DIR/bin/node" ]; then
    # NOTE: the tarball MUST keep its dist filename: SHASUMS256.txt
    # references that name, and sha256sum -c resolves it relative to
    # cwd. Saving under a different name (run 12 lesson) makes the
    # checksum step fail with "No such file or directory".
    TARBALL="/tmp/node-${NODE_VERSION}-linux-x64.tar.xz"
    curl --retry 3 -fsSL "https://nodejs.org/dist/${NODE_VERSION}/node-${NODE_VERSION}-linux-x64.tar.xz" -o "$TARBALL"
    curl --retry 3 -fsSL "https://nodejs.org/dist/${NODE_VERSION}/SHASUMS256.txt" -o /tmp/SHASUMS256.txt
    LINE=$(grep "node-${NODE_VERSION}-linux-x64.tar.xz" /tmp/SHASUMS256.txt || true)
    [ -n "$LINE" ] || {
        echo "dclawos-engine: tarball checksum line missing" >&2
        exit 1
    }
    printf '%s\n' "$LINE" | (cd /tmp && sha256sum -c -)
    mkdir -p "$NODE_DIR"
    tar -xJf "$TARBALL" -C "$NODE_DIR" --strip-components=1
    rm -f "$TARBALL" /tmp/SHASUMS256.txt
fi
"$NODE_DIR/bin/node" --version | grep -q '^v24\.' || {
    echo "dclawos-engine: unexpected node version" >&2
    exit 1
}
ln -sf "$NODE_DIR/bin/node" /usr/local/bin/dclawos-node
export PATH="$NODE_DIR/bin:$PATH"

# 2. Build dependencies (pinned versions, build-time only).
rm -rf "$STAGE"
mkdir -p "$STAGE"
printf '%s\n' '{"name":"dclawos-engine-build","private":true}' > "$STAGE/package.json"
cd "$STAGE"
npm install --no-audit --no-fund --fetch-retries=3 \
  esbuild@0.28.2 zod@4.6.7 undici@8.12.3 ws@8.21.3 socks@2.8.9 \
  yazl@3.3.1 safe-regex@2.1.1

# 3. Bundle the decision entry (subset imports resolve via aliases;
#    bare runtime deps resolve via NODE_PATH into the staging tree —
#    esbuild 0.28's CLI has no --node-paths flag).
mkdir -p "$ENGINE_OUT"
NODE_PATH="$STAGE/node_modules" "$STAGE/node_modules/.bin/esbuild" \
  "$ENGINE_SRC/dclawos/decision.ts" \
  --bundle --platform=node --format=cjs \
  --outfile="$ENGINE_OUT/decision.js" \
  --alias:@="$ENGINE_SRC/src" \
  --alias:@omniroute/open-sse="$ENGINE_SRC/open-sse" \
  --log-level=warning
[ -s "$ENGINE_OUT/decision.js" ] || {
    echo "dclawos-engine: bundle empty" >&2
    exit 1
}

# 3b. Bundle the LLM execution entry (Phase 4 module 1). Separate
#     bundle: decision.js must stay free of the dispatch marker, so
#     llm.ts (which imports dispatch.ts) is bundled on its own.
NODE_PATH="$STAGE/node_modules" "$STAGE/node_modules/.bin/esbuild" \
  "$ENGINE_SRC/dclawos/llm.ts" \
  --bundle --platform=node --format=cjs \
  --outfile="$ENGINE_OUT/llm.js" \
  --alias:@="$ENGINE_SRC/src" \
  --alias:@omniroute/open-sse="$ENGINE_SRC/open-sse" \
  --log-level=warning
[ -s "$ENGINE_OUT/llm.js" ] || {
    echo "dclawos-engine: llm bundle empty" >&2
    exit 1
}

# 4. Catalog + behavior gate (real execution, not presence-only).
/usr/local/bin/dclawos-route --catalog > "$ENGINE_OUT/catalog.json"
python3 -m json.tool "$ENGINE_OUT/catalog.json" > /dev/null || {
    echo "dclawos-engine: catalog.json invalid" >&2
    exit 1
}
/usr/local/bin/dclawos-route --selftest
# LLM executor gate: real execution against a local mock endpoint
# (no real keys, no external network).
/usr/local/bin/dclawos-llm --selftest

# 5. Cleanup (keep /opt/dclawos-node runtime + engine outputs + source).
cd /
rm -rf "$STAGE"
